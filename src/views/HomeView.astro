---
import Base from '../layouts/Base.astro';
import FramesWord from '../components/FramesWord.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { href, type Locale } from '../i18n/config';
import { home } from '../content/home';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const other: Locale = locale === 'en' ? 'pt' : 'en';
---

<Base locale={locale} route="home" altHref={href('home', other)} pageId="home">
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero__title t-display">
      {home.headlineBefore[locale]}<FramesWord locale={locale} word={home.word[locale]} after={home.headlineAfter[locale]} />
    </h1>
    <p class="hero__based">{home.based[locale]}</p>
  </section>

  <section id="work" class="work" aria-labelledby="work-title">
    <h2 id="work-title" class="work__title t-label">{home.workLabel[locale]}<span class="caret" aria-hidden="true"></span></h2>
    <ProjectGrid locale={locale} />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-16) var(--space-24);
  }
  .hero__title { max-width: 22ch; }
  .hero__based { font-size: var(--type-lede); line-height: 1.5; color: var(--color-graphite); }

  .work { scroll-margin-top: var(--space-8); }
  .work__title { margin-bottom: var(--space-6); color: var(--color-graphite-soft); }

  @media (min-width: 64.0625rem) {
    .hero { padding-top: var(--space-24); }
  }
  @media (max-width: 40rem) {
    .hero { gap: var(--space-4); padding-block: var(--space-12) var(--space-16); }
  }
</style>
