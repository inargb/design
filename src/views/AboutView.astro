---
// About: an intro with the portrait, then one row per topic, label on the
// left and content on the right (stacked on phones).
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { href, type L10n, type Locale } from '../i18n/config';
import { about } from '../content/about';
import { photos } from '../content/photos';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const other: Locale = locale === 'en' ? 'pt' : 'en';
const tr = (v: L10n | string) => (typeof v === 'string' ? v : v[locale]);
// Kind words mark their key phrase as [[…]]; it reads a shade darker.
const parts = (q: string) => q.split(/\[\[|\]\]/).map((text, i) => ({ text, key: i % 2 === 1 }));
---

<Base locale={locale} route="about" altHref={href('about', other)} pageId="about" title={about.intro.label[locale]}>
  <section class="intro" aria-labelledby="about-title">
    <div class="intro__text">
      <p class="t-label intro__label">{about.intro.label[locale]}</p>
      <h1 id="about-title" class="t-display">{about.intro.title[locale]}</h1>
      <p class="t-lede">{about.intro.body[locale]}</p>
    </div>
    <figure class="intro__portrait" data-develop>
      <Image src={about.portrait} alt={about.hello.portraitAlt[locale]} widths={[360, 720]} sizes="(max-width: 40rem) 60vw, 16rem" />
    </figure>
  </section>

  <section class="row" aria-labelledby="hello-title">
    <h2 id="hello-title" class="row__label">{about.hello.title[locale]}</h2>
    <div class="row__body prose">
      {about.hello.body.map((p) => <p>{p[locale]}</p>)}
    </div>
  </section>

  <section class="row" aria-labelledby="exp-title">
    <h2 id="exp-title" class="row__label">{about.experience.label[locale]}</h2>
    <ol class="row__body entries" role="list">
      {about.experience.items.map((x) => (
        <li class="entry">
          <span class="entry__main">{tr(x.org)}</span>
          <span class="entry__sub">{x.role[locale]}</span>
          <span class="entry__when">{x.when[locale]}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="row" aria-labelledby="edu-title">
    <h2 id="edu-title" class="row__label">{about.education.label[locale]}</h2>
    <div class="row__body">
      {about.education.groups.map((g) => (
        <div class="group">
          <h3 class="group__title">{g.heading[locale]}</h3>
          <ol class="entries" role="list">
            {g.items.map((x) => (
              <li class="entry">
                <span class="entry__main" lang={x.title.en === x.title.pt ? 'en' : undefined}>{x.title[locale]}</span>
                <span class="entry__sub">{x.org[locale]}</span>
                <span class="entry__when">{x.period[locale]}</span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="row" aria-labelledby="craft-title">
    <h2 id="craft-title" class="row__label">{about.disciplines.label[locale]}</h2>
    <div class="row__body">
      <ul class="cols" role="list">
        {about.disciplines.items.map((d) => <li>{d.label[locale]}</li>)}
      </ul>
      <div class="group">
        <h3 class="group__title">{about.tools.label[locale]}</h3>
        <ul class="tools" role="list">{about.tools.items.map((tool) => <li>{tool.name}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="row" aria-labelledby="words-title">
    <h2 id="words-title" class="row__label">{about.words.label[locale]}</h2>
    <ul class="row__body quotes" role="list">
      {about.words.items.map((w) => (
        <li>
          <figure class="quote">
            <blockquote>
              <p>“{parts(w.quote[locale]).map((part) => part.key ? <span class="quote__key">{part.text}</span> : part.text)}”</p>
            </blockquote>
            <figcaption><span class="quote__name">{w.name}</span> <span class="quote__role">{w.role[locale]}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <section class="row" aria-labelledby="art-title">
    <h2 id="art-title" class="row__label">{about.art.label[locale]}</h2>
    <div class="row__body">
      <p class="art__title t-heading-m">{about.art.title[locale]}</p>
      <div class="prose">
        {about.art.body.map((p) => <p>{p[locale]}</p>)}
      </div>
    </div>
  </section>

  <section class="photos" aria-label={about.art.strip[locale]}>
    <ul class="photos__row" role="list" tabindex="0">
      {photos.map((ph) => (
        <li><Image src={ph.src} alt={ph.alt[locale]} height={480} widths={[Math.round(ph.src.width * 240 / ph.src.height), Math.round(ph.src.width * 480 / ph.src.height)]} sizes={`${Math.round(ph.src.width * 240 / ph.src.height)}px`} loading="lazy" /></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: var(--space-12);
    align-items: end;
    padding-block: var(--space-16) var(--space-16);
  }
  .intro__text { display: grid; gap: var(--space-6); }
  .intro__label { color: var(--color-graphite-soft); }
  .intro__portrait { overflow: hidden; border-radius: var(--radius-soft); background: var(--color-paper-shade); }
  .intro__portrait :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  @media (min-width: 64.0625rem) { .intro { padding-top: var(--space-24); } }
  @media (max-width: 48rem) {
    .intro { grid-template-columns: 1fr; padding-top: var(--space-12); }
    .intro__portrait { width: min(14rem, 60%); order: -1; }
  }

  /* One row per topic: label | content. */
  .row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--space-4) var(--space-8);
    padding-block: var(--space-12);
    border-top: var(--rule-hair);
  }
  .row__label {
    font-family: var(--font-body);
    font-size: var(--type-body-s);
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-ink);
  }
  @media (max-width: 48rem) { .row { grid-template-columns: 1fr; padding-block: var(--space-8); } }

  .prose { display: grid; gap: var(--space-4); max-width: var(--layout-text); }
  .prose p { color: var(--color-graphite); text-wrap: pretty; }

  .entries { display: grid; }
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 var(--space-6);
    padding-block: var(--space-3);
    border-bottom: var(--rule-hair);
  }
  .entry:first-child { padding-top: 0; }
  .entry:last-child { border-bottom: 0; }
  .entry__main { color: var(--color-ink); font-weight: 500; text-wrap: pretty; }
  .entry__sub { grid-column: 1; color: var(--color-graphite); font-size: var(--type-body-s); }
  .entry__when { grid-column: 2; grid-row: 1; font-size: var(--type-body-s); color: var(--color-graphite-soft); white-space: nowrap; font-variant-numeric: tabular-nums; }
  @media (max-width: 40rem) {
    .entry { grid-template-columns: 1fr; }
    .entry__when { grid-column: 1; grid-row: auto; }
  }

  .group + .group, .cols + .group { margin-top: var(--space-8); }
  .group__title { margin-bottom: var(--space-3); font-family: var(--font-body); font-size: var(--type-caption); font-weight: 500; color: var(--color-graphite-soft); }

  .cols { columns: 2 14rem; column-gap: var(--space-8); }
  .cols li { padding-block: var(--space-1); color: var(--color-graphite); break-inside: avoid; }
  .tools { display: flex; flex-wrap: wrap; gap: var(--space-2); max-width: var(--layout-text); }
  .tools li { padding: 2px var(--space-3); border: var(--rule-hair); border-radius: var(--radius-pill); font-size: var(--type-body-s); color: var(--color-graphite); background: var(--color-surface); }

  .quotes { display: grid; gap: var(--space-8); max-width: 42rem; }
  .quote { display: grid; gap: var(--space-3); }
  .quote blockquote { margin: 0; }
  .quote p { font-family: var(--font-title); font-size: var(--type-heading-s); line-height: 1.5; color: var(--color-graphite); text-wrap: pretty; }
  .quote__key { color: var(--color-ink); }
  .quote figcaption { font-size: var(--type-caption); color: var(--color-graphite-soft); }
  .quote__name { color: var(--color-ink); font-weight: 500; }

  .art__title { max-width: 26ch; margin-bottom: var(--space-4); }

  /* Film photographs: one quiet row that scrolls sideways. */
  .photos { margin-top: var(--space-4); }
  .photos__row {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    padding-bottom: var(--space-3);
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }
  .photos__row li { flex: none; scroll-snap-align: start; }
  .photos__row :global(img) { height: 15rem; width: auto; border-radius: var(--radius-soft); }
  @media (max-width: 40rem) { .photos__row :global(img) { height: 11rem; } }
</style>
