---
// Shelf: the shelf from inasilva.com on one screen-high page
// (top bar, no footer). Objects open things: the camera a roll of film,
// the iPod a working iPod, the films their pages.
import Base from '../layouts/Base.astro';
import Shelf from '../components/playground/Shelf.astro';
import FilmViewer from '../components/playground/FilmViewer.astro';
import IPod from '../components/playground/IPod.astro';
import { href, type Locale } from '../i18n/config';
import { playground as pg } from '../content/playground';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const other: Locale = locale === 'en' ? 'pt' : 'en';
---

<Base locale={locale} route="shelf" altHref={href('shelf', other)} pageId="shelf" title={pg.title[locale]} description={pg.intro[locale]}>
  <section class="pg" aria-labelledby="pg-title">
    <h1 id="pg-title" class="pg__title">{pg.heading[locale]}</h1>
    <div class="pg__shelf">
      <Shelf locale={locale} />
    </div>
  </section>
  <FilmViewer locale={locale} />
  <IPod locale={locale} />
</Base>

<style>
  /* Only the top bar here: no footer; the page is at least one screen high. */
  :global(body:has(.pg) .footer) { display: none; }
  .pg {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-4);
    min-height: calc(100svh - var(--nav-height));
    padding-block: var(--space-12) var(--space-8);
  }
  .pg__shelf { display: grid; align-content: center; }
  /* The ask, in the site's mono, mid grey, above the shelf. */
  .pg__title {
    justify-self: center;
    text-align: center;
    font-family: var(--font-system);
    font-size: var(--type-heading-s);
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--color-graphite-soft);
  }
  /* Things can be dragged anywhere on the page: nothing clips them. */
  .pg, .pg__shelf { overflow: visible; }
</style>
