---
// One 404 for both languages: GitHub Pages serves a single 404.html.
// The way back is in Portuguese for visitors whose browser is set to it.
import Base from '../layouts/Base.astro';
import { href } from '../i18n/config';
import { ui } from '../i18n/ui';
const n = ui.notFound;
const back = { en: 'Back to the home page', pt: 'Voltar para o início' };
---

<Base locale="en" altHref={href('home', 'pt')} pageId="404" title="404">
  <section class="nf">
    <p class="t-label nf__code">404</p>
    <h1 class="t-display">{n.title.en}</h1>
    <p class="t-lede">{n.body.en}</p>
    <p class="t-body t-secondary" lang="pt-BR">{n.title.pt} {n.body.pt}</p>
    <a class="link nf__back" href={href('home', 'en')} data-back data-pt-href={href('home', 'pt')} data-pt-label={back.pt}>{back.en}</a>
  </section>
</Base>

<script>
  const a = document.querySelector<HTMLAnchorElement>('[data-back]');
  if (a && navigator.language?.toLowerCase().startsWith('pt')) {
    a.href = a.dataset.ptHref!;
    a.textContent = a.dataset.ptLabel!;
    a.lang = 'pt-BR';
  }
</script>

<style>
  .nf { display: grid; justify-items: start; gap: var(--space-4); padding-block: var(--space-24); }
  .nf > * { max-width: 40rem; }
  .nf__code { color: var(--color-graphite-soft); }
  .nf__back { margin-top: var(--space-4); }
</style>
