---
// LOCAL ONLY. Renders a protected case's body so scripts/seal.mjs can
// encrypt it. Pages exist only when private/<slug>/case.ts is present
// (never in the repo or in CI), and seal.mjs deletes them after sealing.
import CaseIndex from '../../../components/case/CaseIndex.astro';
import CaseSections from '../../../components/case/CaseSections.astro';
import { privateCases } from '../../../content/cases/sealed';
import type { CaseStudy } from '../../../content/cases/types';
import type { Locale } from '../../../i18n/config';

export function getStaticPaths() {
  return Object.values(privateCases).flatMap((study) =>
    (['en', 'pt'] as const).map((locale) => ({ params: { slug: study.slug, locale }, props: { study, locale } })));
}
const { study, locale } = Astro.props as { study: CaseStudy; locale: Locale };
---
<html lang={locale}><head><meta name="robots" content="noindex" /></head><body>
<i data-seal-start="index"></i><CaseIndex study={study} locale={locale} /><i data-seal-end="index"></i>
<i data-seal-start="sections"></i><CaseSections study={study} locale={locale} /><i data-seal-end="sections"></i>
<script type="application/json" data-seal-public set:html={JSON.stringify({ slug: study.slug, tools: study.tools, facts: study.facts })}></script>
</body></html>
