---
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/inter/opsz-italic.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, type Locale, type RouteId } from '../i18n/config';
import { ui } from '../i18n/ui';
import { site } from '../content/site';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  route?: RouteId | 'case';   // current top-level route (for nav state)
  altHref: string;            // same page in the other language
  pageId: string;
}

const { locale, title, description, route, altHref, pageId } = Astro.props;
const root = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fullTitle = title ? `${title} · ${site.name}` : site.title[locale];
const desc = description ?? site.description[locale];
const canonical = new URL(Astro.url.pathname, Astro.site);
// Pages can replace the sidebar navigation (a case shows its own index there).
const hasAside = Astro.slots.has('aside');
---

<!doctype html>
<html lang={htmlLang[locale]} data-page={pageId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'en' ? 'pt-BR' : 'en'} href={new URL(altHref, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta name="theme-color" content="#f6f6f4" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={`${root}favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${root}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${root}favicon-48.png`} />
    <link rel="apple-touch-icon" href={`${root}apple-touch-icon.png`} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if ('IntersectionObserver' in window) d.classList.add('js-reveal');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip[locale]}</a>
    <div class="shell">
      <Nav locale={locale} route={route} altHref={altHref} hasAside={hasAside}>
        <slot name="aside" />
      </Nav>
      <main id="main" class="shell__main" tabindex="-1">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
    <script>
      import '../scripts/prefs';
      import '../scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  /* The page: a header row (name, language), a narrow sidebar (navigation, or
     a case's index) and one content column. Phones and tablets: one column,
     with the navigation in the header. */
  .shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-inline: var(--layout-gutter);
  }
  .shell__main { min-width: 0; outline: none; }

  @media (min-width: 64.0625rem) {
    .shell {
      grid-template-columns: var(--layout-side) minmax(0, var(--layout-max)) minmax(0, 1fr);
      grid-template-rows: auto 1fr auto;
      column-gap: var(--space-12);
    }
    .shell > .site-header { grid-column: 1 / -1; grid-row: 1; }
    .shell > .site-side { grid-column: 1; grid-row: 2 / span 2; }
    .shell__main { grid-column: 2; grid-row: 2; }
    .shell > .footer { grid-column: 2; grid-row: 3; }
  }
</style>
