---
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/inter/opsz-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/400-italic.css';
import '@fontsource/ibm-plex-mono/500-italic.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, type Locale, type RouteId } from '../i18n/config';
import { ui } from '../i18n/ui';
import { site } from '../content/site';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  route?: RouteId | 'case';   // current top-level route (for nav state)
  altHref: string;            // same page in the other language
  pageId: string;
}

const { locale, title, description, route, altHref, pageId } = Astro.props;
const root = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fullTitle = title ? `${title} · ${site.name}` : site.title[locale];
const desc = description ?? site.description[locale];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={htmlLang[locale]} data-page={pageId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'en' ? 'pt-BR' : 'en'} href={new URL(altHref, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta name="theme-color" content="#f6f6f4" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={`${root}favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${root}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${root}favicon-48.png`} />
    <link rel="apple-touch-icon" href={`${root}apple-touch-icon.png`} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if ('IntersectionObserver' in window) d.classList.add('js-reveal');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip[locale]}</a>
    <Nav locale={locale} route={route} altHref={altHref} />
    <div class="page container">
      <main id="main" class="page__main" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer locale={locale} />
    <script>
      import '../scripts/prefs';
      import '../scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  /* The page: the top bar, one centred column, then the footer. */
  .page__main { outline: none; }
</style>
