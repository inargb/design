---
// Inaiá's hand-drawn faces, traced to vector so they recolour with the
// page. Decorative: hidden from screen readers, not interactive.
import happy from '../assets/doodles/happy.svg?raw';
import wonder from '../assets/doodles/wonder.svg?raw';
import type { Locale } from '../i18n/config';

interface Props {
  variant?: 'happy' | 'wonder';
  locale?: Locale;
  class?: string;
}
const { variant = 'happy', class: cls } = Astro.props;
const svg = variant === 'happy' ? happy : wonder;
---

<span class:list={['doodle', `doodle--${variant}`, cls]} data-doodle aria-hidden="true">
  <span class="doodle__face" set:html={svg} />
  <span class="doodle__z"><i>z</i><i>z</i><i>z</i></span>
</span>

<style>
  .doodle {
    --look-x: 0px;
    --look-y: 0px;
    --look-r: 0deg;
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
  }
  .doodle__face {
    display: block;
    width: 100%;
    height: 100%;
    translate: var(--look-x) var(--look-y);
    rotate: var(--look-r);
    transition: translate var(--duration-slow) var(--ease-settle), rotate var(--duration-slow) var(--ease-settle),
      scale var(--duration-settle) var(--ease-settle), opacity var(--duration-settle);
  }
  .doodle__face :global(svg) { width: 100%; height: 100%; overflow: visible; }
  .doodle__face :global(.doodle-ink) { fill: var(--color-ink); transition: fill var(--duration-slow); }
  .doodle__face :global(.doodle-eyes) { fill: var(--color-highlight); }

  /* Sleepy: eyes dim, little z's float up. */
  .doodle__z {
    position: absolute;
    top: 8%;
    right: 4%;
    font-family: var(--font-system);
    color: var(--color-graphite);
    pointer-events: none;
    opacity: 0;
  }
  .doodle__z i { display: inline-block; font-style: normal; }
  .doodle.is-sleepy .doodle__z { opacity: 1; }
  .doodle.is-sleepy .doodle__z i { animation: zz 2.4s var(--ease-soft) infinite; }
  .doodle.is-sleepy .doodle__z i:nth-child(2) { animation-delay: 0.5s; font-size: 1.2em; }
  .doodle.is-sleepy .doodle__z i:nth-child(3) { animation-delay: 1s; font-size: 1.45em; }
  @keyframes zz { 0% { opacity: 0; translate: 0 6px; } 40% { opacity: 1; } 100% { opacity: 0; translate: 4px -14px; } }
  .doodle.is-sleepy :global(.doodle-eyes) { fill: var(--color-paper-deep); }
  .doodle.is-sleepy .doodle__face { rotate: -6deg; translate: 0 3%; }
</style>
