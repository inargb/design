---
// The film strip drifts by itself (~22px/s), in a seamless loop: the photo
// set is duplicated and the track wraps after exactly one set's width.
//   · pauses on hover, keyboard focus, drag, and while off-screen
//   · resumes ~2s after the last interaction
//   · drag, horizontal wheel and arrow keys still move it
//   · the first time it comes into view, the visible photos develop one by
//     one (pale print → full tone); only then does the drift start
//   · reduced motion → developed, still, draggable
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/config';
import { about } from '../content/about';
import { photos } from '../content/photos';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const a = about.art;
---

<div class="film" data-film>
  <div class="film__viewport" tabindex="0" role="region" aria-label={a.strip[locale]} data-film-viewport data-cursor="drag">
    <ol class="film__track" role="list" data-film-track>
      {[0, 1].map((copy) =>
        photos.map((ph, i) => (
          <li class="film__frame" data-film-frame aria-hidden={copy === 1 ? 'true' : undefined}>
            <Image src={ph.src} alt={copy === 1 ? '' : ph.alt[locale]} widths={[420, 840]} sizes="(max-width: 40rem) 70vw, 26rem" loading="lazy" draggable="false" />
            <span class="film__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}A</span>
          </li>
        )),
      )}
    </ol>
  </div>
</div>

<style>
  .film__viewport {
    overflow: hidden;
    padding-block: var(--space-6);
    background: #141210;
    /* sprocket holes */
    background-image:
      radial-gradient(circle at 50% 50%, #fbfbfd 0 3px, transparent 3.5px),
      radial-gradient(circle at 50% 50%, #fbfbfd 0 3px, transparent 3.5px);
    background-size: 22px 22px, 22px 22px;
    background-position: 0 4px, 0 calc(100% - 4px);
    background-repeat: repeat-x;
    touch-action: pan-y;
    user-select: none;
  }
  .film__viewport:focus-visible { outline-offset: -4px; }
  .film__track { display: flex; gap: var(--space-4); width: max-content; padding-left: var(--space-4); will-change: transform; }
  .film__frame { position: relative; width: clamp(15rem, 60vw, 26rem); flex: none; }
  .film__frame :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; pointer-events: none; }
  .film__no { position: absolute; left: var(--space-2); bottom: calc(-1 * var(--space-6) + 4px); font-family: var(--font-system); font-size: 0.625rem; color: #f3cf1c; letter-spacing: 0.1em; }
  /* Develops once: frames start as pale prints (only when JS will develop
     them) and come up to full tone one by one. */
  .film.is-developing .film__frame :global(img) {
    filter: grayscale(1) contrast(0.55) brightness(1.35) sepia(0.25);
    opacity: 0.35;
    transition: filter var(--duration-develop) var(--ease-develop),
      opacity calc(var(--duration-develop) * 0.6) var(--ease-soft);
    transition-delay: var(--develop-delay, 0ms);
  }
  .film.is-developing .film__frame.is-developed :global(img) { filter: none; opacity: 1; }
</style>

<script>
  import { motionOn } from '../scripts/prefs';

  const root = document.querySelector<HTMLElement>('[data-film]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const viewport = root.querySelector<HTMLElement>('[data-film-viewport]')!;
    const track = root.querySelector<HTMLElement>('[data-film-track]')!;
    const frames = Array.from(root.querySelectorAll<HTMLElement>('[data-film-frame]'));
    const SPEED = 22;          // px per second: it should drift, not move
    const RESUME_AFTER = 2000; // ms of idle before drifting again
    const DEVELOP_STEP = 380;  // ms between one print and the next

    let x = 0;
    let setWidth = 0;
    let last = 0;
    let developed = !motionOn(); // the drift waits for the first develop
    let holding = false;       // hover / focus / drag
    let idleUntil = 0;
    let onScreen = false;
    let raf = 0;

    const measure = () => { setWidth = track.scrollWidth / 2; };
    const wrap = () => {
      if (!setWidth) return;
      while (x <= -setWidth) x += setWidth;
      while (x > 0) x -= setWidth;
    };
    const paint = () => { track.style.transform = `translate3d(${x}px, 0, 0)`; };
    const drifting = () => motionOn() && developed && !holding && onScreen && performance.now() > idleUntil;

    function tick(now: number) {
      const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
      last = now;
      if (drifting()) { x -= SPEED * dt; wrap(); paint(); }
      raf = onScreen ? requestAnimationFrame(tick) : 0;
    }
    const start = () => { if (!raf) { last = 0; raf = requestAnimationFrame(tick); } };
    const touch = () => { idleUntil = performance.now() + RESUME_AFTER; };

    // ---- Develop, once ----------------------------------------------------
    // Pale prints only if JS is here to develop them.
    let developTimer = 0;
    const finishDevelop = () => {
      if (developed) return;
      window.clearTimeout(developTimer);
      frames.forEach((f) => f.classList.add('is-developed'));
      developed = true;
    };
    function develop() {
      const box = viewport.getBoundingClientRect();
      const inView = frames.filter((f) => {
        const r = f.getBoundingClientRect();
        return r.right > box.left && r.left < box.right;
      });
      inView.forEach((f, i) => {
        f.style.setProperty('--develop-delay', `${i * DEVELOP_STEP}ms`);
        f.classList.add('is-developed');
      });
      const duration = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--duration-develop')) || 0;
      // Everything else develops out of sight, then the loop starts.
      developTimer = window.setTimeout(finishDevelop, (inView.length - 1) * DEVELOP_STEP + duration);
    }
    if (!developed) root.classList.add('is-developing');
    window.addEventListener('ina:prefs', () => { if (!motionOn()) finishDevelop(); });

    // Hover and keyboard focus hold the strip still.
    viewport.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') holding = true; });
    viewport.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { holding = false; touch(); } });
    viewport.addEventListener('focus', () => { holding = true; });
    viewport.addEventListener('blur', () => { holding = false; touch(); });

    // Moving it by hand finishes the develop, so no pale print scrolls in.
    const move = (dx: number) => { finishDevelop(); x += dx; wrap(); paint(); touch(); };

    // Drag (mouse, touch, pen).
    let dragging = false, px = 0;
    viewport.addEventListener('pointerdown', (e) => {
      dragging = true; px = e.clientX;
      viewport.setPointerCapture(e.pointerId);
    });
    viewport.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      move(e.clientX - px); px = e.clientX;
    });
    const end = () => { dragging = false; touch(); };
    viewport.addEventListener('pointerup', end);
    viewport.addEventListener('pointercancel', end);

    // Horizontal wheel / trackpad.
    viewport.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      e.preventDefault();
      move(-e.deltaX);
    }, { passive: false });

    // Arrow keys.
    viewport.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      move(e.key === 'ArrowLeft' ? 240 : -240);
    });

    // Only run while on screen; develop the first time it is well in view.
    let seen = false;
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) start();
    }).observe(viewport);
    const firstLook = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting || seen) return;
      seen = true;
      firstLook.disconnect();
      if (!developed) develop();
    }, { threshold: 0.5 });
    firstLook.observe(viewport);

    new ResizeObserver(() => { measure(); wrap(); paint(); }).observe(track);
    measure();
  }
</script>
