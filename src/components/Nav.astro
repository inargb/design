---
// The site's navigation, in two places:
//   desktop (> 64rem) → name top-left, language top-right, and the links in a
//                       sticky sidebar. A page can put its own content in the
//                       sidebar instead (a case shows its index there).
//   tablet + phone     → one header row: name, links and language.
// The current page gets the accent colour and a small square in front.
import LanguageSwitch from './LanguageSwitch.astro';
import { href, type Locale, type RouteId } from '../i18n/config';
import { ui } from '../i18n/ui';
import { site } from '../content/site';

interface Props { locale: Locale; route?: RouteId | 'case'; altHref: string; hasAside?: boolean; }
const { locale, route, altHref, hasAside = false } = Astro.props;
const n = ui.nav;
const homeHref = href('home', locale);
const workHref = `${homeHref}${homeHref.endsWith('/') ? '' : '/'}#work`;
type Current = 'page' | 'true' | undefined;
const links: { label: string; href: string; current: Current }[] = [
  { label: n.work[locale], href: workHref, current: route === 'home' ? 'page' : route === 'case' ? 'true' : undefined },
  { label: n.about[locale], href: href('about', locale), current: route === 'about' ? 'page' : undefined },
];
---

<header class="site-header">
  <a class="site-header__name" href={homeHref} aria-label={n.home[locale]}>{site.name}</a>

  <nav class="site-header__nav" aria-label={n.label[locale]}>
    <ul role="list">
      {links.map((l) => <li><a class="nav-link" href={l.href} aria-current={l.current}>{l.label}</a></li>)}
      <li>
        <a class="nav-link" href={site.links.resume[locale]} target="_blank" rel="noopener">
          {n.resume[locale]}<span aria-hidden="true">&thinsp;↗</span><span class="visually-hidden"> {n.newTab[locale]}</span>
        </a>
      </li>
    </ul>
  </nav>

  <LanguageSwitch locale={locale} altHref={altHref} />
</header>

<aside class="site-side">
  <div class="site-side__inner">
    {hasAside ? <slot /> : (
      <nav aria-label={n.label[locale]}>
        <ul class="site-side__links" role="list">
          {links.map((l) => <li><a class="nav-link" href={l.href} aria-current={l.current}>{l.label}</a></li>)}
          <li>
            <a class="nav-link" href={site.links.resume[locale]} target="_blank" rel="noopener">
              {n.resume[locale]}<span aria-hidden="true">&thinsp;↗</span><span class="visually-hidden"> {n.newTab[locale]}</span>
            </a>
          </li>
        </ul>
      </nav>
    )}
  </div>
</aside>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--nav-height);
    border-bottom: var(--rule-hair);
  }
  .site-header__name {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-right: auto;
    font-size: var(--type-nav);
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
  }
  .site-header__nav ul { display: flex; gap: var(--space-4); }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-size: var(--type-nav);
    color: var(--color-graphite-soft);
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-soft);
  }
  .nav-link:hover { color: var(--color-ink); }
  .nav-link[aria-current] { color: var(--color-accent); }

  .site-side { display: none; }

  @media (min-width: 64.0625rem) {
    .site-header { border-bottom: 0; }
    .site-header__nav { display: none; }
    .site-side { display: block; }
    .site-side__inner {
      position: sticky;
      top: var(--space-8);
      padding-top: var(--space-24);
    }
    .site-side__links { display: grid; }
    .site-side__links .nav-link { min-height: 2rem; }
    .site-side__links .nav-link[aria-current]::before {
      content: '';
      position: absolute;
      left: calc(-1 * var(--space-4));
      top: 50%;
      width: 5px;
      height: 5px;
      translate: 0 -50%;
      background: currentColor;
    }
  }
</style>
