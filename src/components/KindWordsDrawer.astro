---
// "Things people said, kept in a drawer": the interaction does what the
// heading says. Four states:
//   1 closed → the drawer front, note tops peeking out
//   2 open   → the drawer slides out (~400ms), notes fan out at ±2–4°
//   3 read   → a note lifts into a dialog; arrows / swipe move, Esc puts it back
//   4 close  → pressing the drawer front again slides it back in (cursor: "close")
// The notes are a real <ul>, readable by screen readers even when closed.
// Reduced motion: no slide, no fan: opening shows a static grid.
// Phone: opens into a vertical stack, no fanning.
import type { Locale } from '../i18n/config';
import { about } from '../content/about';
import { ui } from '../i18n/ui';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const w = about.words;
const d = w.drawer;
const tilts = [-3, 2.5, -2, 3.5, -2.5];
// [[phrase]] becomes the yellow highlighter mark.
const marked = (s: string) => s.replace(/\[\[(.+?)\]\]/g, '<mark class="mark">$1</mark>');
const n = w.items.length;
---

<div class="drawer" data-drawer data-open="false" data-i18n={JSON.stringify({ of: d.of[locale] })}>
  <div class="drawer__well" id="kind-words-notes" data-drawer-well>
    <ul class="drawer__notes" role="list">
      {w.items.map((item, i) => (
        <li class="note" style={`--tilt:${tilts[i % tilts.length]}deg; --i:${i}`} data-note>
          <figure class="note__paper">
            <blockquote class="t-body-s"><p set:html={marked(item.quote[locale])} /></blockquote>
            <figcaption class="note__who">
              <span class="t-caption note__name">{item.name}</span>
              <span class="t-caption">{item.role[locale]}</span>
            </figcaption>
          </figure>
          <button class="note__read" type="button" tabindex="-1" data-note-read={i}>
            <span class="visually-hidden">{d.read[locale]}: {item.name}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <button class="drawer__front" type="button" aria-expanded="false" aria-controls="kind-words-notes" data-drawer-front data-cursor="open" data-cursor-open={ui.cursor.open[locale]} data-cursor-close={ui.cursor.close[locale]}>
    <span class="drawer__label t-label">{d.front[locale]} <span class="drawer__count">({n})</span></span>
    <span class="drawer__handle" aria-hidden="true"></span>
    <span class="visually-hidden" data-front-sr data-close-label={d.close[locale]}>{d.open[locale]}</span>
  </button>
</div>

<dialog class="note-dialog" data-note-dialog aria-label={w.label[locale]}>
  <div class="note-dialog__paper" data-note-slot tabindex="-1"></div>
  <nav class="note-dialog__nav t-nav">
    <button type="button" data-note-prev aria-label={d.prev[locale]}>←</button>
    <span class="note-dialog__count" aria-live="polite" data-note-count></span>
    <button type="button" data-note-next aria-label={d.next[locale]}>→</button>
    <button type="button" class="note-dialog__back" data-note-close>{d.putBack[locale]}</button>
  </nav>
</dialog>

<style>
  .drawer { position: relative; display: grid; }

  /* The well: notes live here. Closed, only their tops peek over the front. */
  .drawer__well {
    position: relative;
    height: 5.5rem;
    overflow: hidden;
    transition: height var(--duration-slow) var(--ease-settle);
  }
  .drawer__notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8) var(--layout-gap);
    padding: var(--space-4) var(--space-4) var(--space-8);
  }
  .note {
    position: relative;
    rotate: calc(var(--tilt) * 0.35);
    translate: 0 calc(1.25rem + var(--i) * 0.2rem);
    transition: rotate var(--duration-slow) var(--ease-settle), translate var(--duration-slow) var(--ease-settle),
      opacity var(--duration-settle) var(--ease-soft);
    transition-delay: calc(var(--i) * 40ms);
  }
  .note__paper {
    margin: 0;
    display: grid;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6);
    background: var(--color-paper);
    border: var(--rule-ink);
    box-shadow: 0 0 0 5px var(--color-paper), 0 0 0 6px var(--color-rule);
  }
  .note__paper blockquote { margin: 0; }
  .note__who { display: grid; gap: 2px; }
  .note__name { color: var(--color-ink); font-weight: 500; }
  .note__read {
    position: absolute;
    inset: 0;
    border: 0;
    background: none;
    padding: 0;
  }
  .note__read:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 8px; }

  /* The drawer front, in the site's 1px line style. */
  .drawer__front {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    min-height: 5rem;
    margin-top: -1px;
    padding: 0 var(--space-6);
    border: var(--rule-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: 0 6px 0 -1px var(--color-paper), 0 6px 0 0 var(--color-ink);
    transition: translate var(--duration-slow) var(--ease-settle), background-color var(--duration-quick);
  }
  .drawer__front:hover { background: var(--color-accent-tint); }
  .drawer__label { justify-self: start; }
  .drawer__count { color: var(--color-accent); }
  .drawer__handle {
    width: 4.5rem;
    height: 0.75rem;
    border: var(--rule-ink);
    border-radius: var(--radius-pill);
    background: var(--color-paper-shade);
  }

  /* 2 · open */
  .drawer[data-open='true'] .drawer__well { overflow: visible; }
  .drawer[data-open='true'] .note { rotate: var(--tilt); translate: 0 0; }
  .drawer[data-open='true'] .drawer__front { translate: 0 var(--space-4); }
  .drawer[data-open='true'] .note:hover { rotate: 0deg; translate: 0 -4px; }

  /* 3 · reading: the others dim */
  .drawer.is-reading .note { opacity: 0.35; }
  .drawer.is-reading .note.is-lifted { opacity: 0; }

  @media (max-width: 64rem) { .drawer__notes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* Phone: a vertical stack, no fanning. */
  @media (max-width: 40rem) {
    .drawer__notes { grid-template-columns: 1fr; gap: var(--space-6); }
    .drawer[data-open='true'] .note { rotate: 0deg; }
    .drawer__front { grid-template-columns: 1fr auto; }
  }
  /* Reduced motion: no slide, no fan; open is a static grid. */
  @media (prefers-reduced-motion: reduce) {
    .drawer[data-open='true'] .note { rotate: 0deg; }
  }

  /* The read dialog: the chosen note, lifted, straight and larger. */
  .note-dialog {
    width: min(38rem, calc(100vw - 2 * var(--layout-gutter)));
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    overflow: visible;
  }
  .note-dialog::backdrop { background: color-mix(in srgb, var(--color-paper) 70%, transparent); backdrop-filter: blur(2px); }
  .note-dialog[open] { animation: lift var(--duration-slow) var(--ease-settle); }
  @keyframes lift { from { opacity: 0; scale: 0.9; rotate: -2deg; translate: 0 1rem; } }
  .note-dialog__paper {
    padding: var(--space-8);
    background: var(--color-paper);
    border: var(--rule-ink);
    box-shadow: 0 0 0 6px var(--color-paper), 0 0 0 7px var(--color-rule), var(--shadow-offset-lift);
    touch-action: pan-y;
  }
  .note-dialog__paper:focus { outline: none; }
  .note-dialog__paper :global(blockquote) { margin: 0 0 var(--space-6); font-size: var(--type-body); }
  .note-dialog__paper :global(.note__who) { display: grid; gap: 2px; }
  .note-dialog__nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .note-dialog__nav button {
    min-width: var(--tap-min);
    min-height: var(--tap-min);
    padding: 0 var(--space-3);
    border: var(--rule-ink);
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .note-dialog__nav button:hover { background: var(--color-accent-tint); }
  .note-dialog__count { min-width: 4rem; text-align: center; font-family: var(--font-system); }
  .note-dialog__back { margin-left: auto; }
</style>

<script>
  import { motionOn } from '../scripts/prefs';

  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-note-dialog]');
  if (drawer && dialog) init(drawer, dialog);

  function init(drawer: HTMLElement, dialog: HTMLDialogElement) {
    const well = drawer.querySelector<HTMLElement>('[data-drawer-well]')!;
    const front = drawer.querySelector<HTMLButtonElement>('[data-drawer-front]')!;
    const frontSr = front.querySelector<HTMLElement>('[data-front-sr]')!;
    const notes = Array.from(drawer.querySelectorAll<HTMLElement>('[data-note]'));
    const reads = Array.from(drawer.querySelectorAll<HTMLButtonElement>('[data-note-read]'));
    const slot = dialog.querySelector<HTMLElement>('[data-note-slot]')!;
    const count = dialog.querySelector<HTMLElement>('[data-note-count]')!;
    const of = JSON.parse(drawer.dataset.i18n ?? '{}').of ?? '/';
    const closedHeight = getComputedStyle(well).height;
    const openLabel = frontSr.textContent ?? '';
    const closeLabel = frontSr.dataset.closeLabel ?? '';
    let current = 0;
    let opener: HTMLElement | null = null;

    function setOpen(open: boolean) {
      drawer.dataset.open = String(open);
      front.setAttribute('aria-expanded', String(open));
      frontSr.textContent = open ? closeLabel : openLabel;
      // The cursor says what a click will do: open, or close.
      front.dataset.cursorLabel = (open ? front.dataset.cursorClose : front.dataset.cursorOpen) ?? '';
      window.dispatchEvent(new Event('ina:cursor'));
      reads.forEach((b) => (b.tabIndex = open ? 0 : -1));
      const animate = motionOn();
      if (open) {
        const target = `${well.scrollHeight}px`;
        well.style.height = animate ? target : 'auto';
        if (animate) well.addEventListener('transitionend', () => { if (drawer.dataset.open === 'true') well.style.height = 'auto'; }, { once: true });
      } else {
        if (animate) {
          well.style.height = `${well.scrollHeight}px`;
          void well.offsetHeight;
        }
        well.style.height = closedHeight;
      }
    }

    front.addEventListener('click', () => {
      const open = drawer.dataset.open !== 'true';
      setOpen(open);
      if (open) reads[0]?.focus({ preventScroll: true });
    });

    // ---- reading -------------------------------------------------------
    function show(i: number) {
      current = (i + notes.length) % notes.length;
      notes.forEach((nEl, k) => nEl.classList.toggle('is-lifted', k === current));
      slot.innerHTML = notes[current].querySelector('.note__paper')!.innerHTML;
      count.textContent = `${current + 1} ${of} ${notes.length}`;
    }
    function read(i: number, from: HTMLElement) {
      opener = from;
      drawer.classList.add('is-reading');
      show(i);
      dialog.showModal();
      slot.focus();
    }
    reads.forEach((b, i) => b.addEventListener('click', () => read(i, b)));
    dialog.querySelector('[data-note-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-note-next]')!.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-note-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
    });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => {
      drawer.classList.remove('is-reading');
      notes.forEach((nEl) => nEl.classList.remove('is-lifted'));
      (reads[current] ?? opener)?.focus();
    });

    // Swipe between notes on touch screens.
    let sx = 0, sy = 0;
    slot.addEventListener('pointerdown', (e) => { sx = e.clientX; sy = e.clientY; });
    slot.addEventListener('pointerup', (e) => {
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>
