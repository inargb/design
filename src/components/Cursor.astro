---
// The viewfinder cursor. Purely decorative: every state it shows is also
// available as visible text or on focus. Only runs on fine pointers.
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = ui.cursor;
---

<div
  class="cursor is-away"
  popover="manual"
  aria-hidden="true"
  data-cursor-root
  data-state="default"
  data-l-view={c.view[locale]}
  data-l-soon={c.soon[locale]}
  data-l-secret={c.secret[locale]}
  data-l-drag={c.drag[locale]}
  data-l-open={c.open[locale]}
  data-l-look={c.look[locale]}
>
  <div class="cursor__cross"></div>
  <div class="cursor__frame">
    <i class="cursor__corner tl"></i><i class="cursor__corner tr"></i>
    <i class="cursor__corner bl"></i><i class="cursor__corner br"></i>
  </div>
  <span class="cursor__label"></span>
</div>

<style>
  .cursor {
    --w: 14px;
    --h: 14px;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 1000;
    pointer-events: none;
    display: none;
    color: var(--color-ink);
  }
  /* It lives in the top layer (a manual popover) so it stays above open
     dialogs and their backdrops; these undo the popover's default box. */
  .cursor[popover] { inset: auto; left: 0; top: 0; margin: 0; padding: 0; border: 0; background: none; overflow: visible; width: auto; height: auto; }
  :global(.has-custom-cursor) .cursor:popover-open { display: block; }
  @supports not selector(:popover-open) { :global(.has-custom-cursor) .cursor { display: block; } }
  .cursor.is-away, .cursor.is-typing { opacity: 0; }
  .cursor[data-invert] { color: var(--color-paper); }

  /* Default: a thin crosshair, the centre of a viewfinder. */
  .cursor__cross {
    position: absolute;
    width: 14px;
    height: 14px;
    translate: -50% -50%;
    background:
      linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat,
      linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat;
    transition: scale var(--duration-quick) var(--ease-settle), opacity var(--duration-quick);
  }
  /* Link: the crosshair becomes a dab of highlighter. */
  .cursor[data-state='link'] .cursor__cross {
    background: var(--color-highlight);
    border-radius: 50%;
    scale: 0.9;
    mix-blend-mode: multiply;
  }

  /* Frame states: corners open around the pointer. */
  .cursor__frame {
    position: absolute;
    width: var(--w);
    height: var(--h);
    translate: -50% -50%;
    opacity: 0;
    transition: width var(--duration-settle) var(--ease-settle),
      height var(--duration-settle) var(--ease-settle),
      opacity var(--duration-quick) var(--ease-soft);
  }
  .cursor__corner {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 0 solid currentColor;
  }
  .tl { top: 0; left: 0; border-top-width: 1.5px; border-left-width: 1.5px; }
  .tr { top: 0; right: 0; border-top-width: 1.5px; border-right-width: 1.5px; }
  .bl { bottom: 0; left: 0; border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .br { bottom: 0; right: 0; border-bottom-width: 1.5px; border-right-width: 1.5px; }

  .cursor__label {
    position: absolute;
    top: calc(var(--h) / 2 + 8px);
    left: 0;
    translate: -50% 0;
    padding: 3px 8px;
    white-space: nowrap;
    font-family: var(--font-system);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    background: var(--color-ink);
    color: var(--color-paper);
    opacity: 0;
    scale: 0.9;
    transition: opacity var(--duration-quick) var(--ease-soft), scale var(--duration-settle) var(--ease-settle),
      top var(--duration-settle) var(--ease-settle);
  }

  .cursor[data-state='project'],
  .cursor[data-state='soon'],
  .cursor[data-state='secret'],
  .cursor[data-state='look'],
  .cursor[data-state='open'],
  .cursor[data-state='drag'] {
    --w: 96px;
    --h: 60px;
  }
  .cursor[data-state='look'] { --w: 44px; --h: 44px; }
  .cursor[data-state='drag'] { --w: 64px; --h: 40px; }

  .cursor:is([data-state='project'], [data-state='soon'], [data-state='secret'], [data-state='look'], [data-state='open'], [data-state='drag']) .cursor__frame { opacity: 1; }
  .cursor:is([data-state='project'], [data-state='soon'], [data-state='secret'], [data-state='look'], [data-state='open'], [data-state='drag']) .cursor__cross { scale: 0.55; }
  .cursor:is([data-state='project'], [data-state='soon'], [data-state='secret'], [data-state='look'], [data-state='open'], [data-state='drag']) .cursor__label { opacity: 1; scale: 1; }

  .cursor[data-state='soon'] .cursor__label { background: var(--color-highlight); color: var(--color-on-highlight); }
  .cursor[data-state='soon'] .cursor__corner { border-style: dashed; }
  .cursor[data-state='soon'] .cursor__frame { animation: wobble 1.6s var(--ease-soft) infinite; }
  .cursor[data-state='secret'] .cursor__label { background: var(--color-accent); color: var(--color-on-accent); }
  @keyframes wobble { 50% { rotate: -2deg; } }

  /* Press: the shutter closes a little. */
  .cursor.is-down .cursor__frame { scale: 0.86; transition: scale var(--duration-instant); }
  .cursor.is-down .cursor__cross { scale: 0.6; }

</style>

<script>
  import '../scripts/cursor';
</script>
