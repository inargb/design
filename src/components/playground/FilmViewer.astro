---
// The camera's roll of film, in a full-screen overlay (a modal <dialog>:
// focus stays inside, Esc closes). The strip scrolls sideways: wheel,
// trackpad, drag, arrow keys or swipe. Opened by the shelf's camera.
import { Image } from 'astro:assets';
import type { Locale } from '../../i18n/config';
import { photos } from '../../content/photos';
import { playground as pg } from '../../content/playground';
import { about } from '../../content/about';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const f = pg.film;
const art = about.art;
---

<dialog class="filmv" aria-labelledby="filmv-title" data-film-dialog>
  <div class="filmv__top">
    <p id="filmv-title" class="filmv__title">{f.title[locale]} <span class="filmv__hint">{f.hint[locale]}</span></p>
    <button class="filmv__close" type="button" data-film-close>{f.close[locale]} <span aria-hidden="true">✕</span></button>
  </div>
  <div class="filmv__text">
    <h2 class="filmv__heading">{art.title[locale]}</h2>
    <div class="filmv__body">{art.body.map((p) => <p>{p[locale]}</p>)}</div>
  </div>
  <div class="filmv__strip" tabindex="0" role="region" aria-label={f.title[locale]} data-film-strip>
    <ol class="filmv__track" role="list">
      {photos.map((ph, i) => (
        <li class="filmv__frame">
          <Image src={ph.src} alt={ph.alt[locale]} widths={[600, 1200]} sizes="(max-width: 40rem) 80vw, 46vh" loading="lazy" draggable="false" />
          <span class="filmv__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}A</span>
        </li>
      ))}
    </ol>
  </div>
</dialog>

<style>
  .filmv {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--space-6) 0;
    border: 0;
    background: rgb(20 18 16 / 0.96);
    color: #f6f6f4;
  }
  .filmv[open] { display: grid; grid-template-rows: auto auto 1fr; gap: var(--space-6); overflow-y: auto; }
  .filmv::backdrop { background: rgb(20 18 16 / 0.6); }
  .filmv__top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding-inline: var(--layout-gutter); }
  .filmv__title { font-family: var(--font-system); font-size: var(--type-caption); letter-spacing: 0.06em; text-transform: uppercase; }
  .filmv__hint { margin-left: var(--space-3); color: rgb(246 246 244 / 0.55); text-transform: none; letter-spacing: 0.02em; }
  .filmv__close {
    min-height: var(--tap-min);
    padding: 0 var(--space-3);
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-system);
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .filmv__close:hover { color: #e8a33c; }

  /* Why the camera: the note from the About page, above the film. */
  .filmv__text {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 38rem);
    gap: var(--space-4) var(--space-12);
    padding-inline: var(--layout-gutter);
  }
  .filmv__heading { font-family: var(--font-title); font-size: var(--type-heading-m); font-weight: 500; line-height: 1.25; letter-spacing: -0.02em; text-wrap: balance; }
  .filmv__body { display: grid; gap: var(--space-2); font-size: var(--type-body-s); line-height: 1.55; color: rgb(246 246 244 / 0.75); text-wrap: pretty; }
  @media (max-width: 48rem) { .filmv__text { grid-template-columns: 1fr; } }

  /* The film: black base, sprocket holes along both edges, frames in a row. */
  .filmv__strip {
    align-self: center;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    padding-block: 2.25rem;
    background-color: #141210;
    background-image:
      radial-gradient(circle, #fbfbf9 0 3.5px, transparent 4px),
      radial-gradient(circle, #fbfbf9 0 3.5px, transparent 4px);
    background-size: 24px 24px, 24px 24px;
    background-position: 0 6px, 0 calc(100% - 6px);
    background-repeat: repeat-x;
    background-attachment: local;
    cursor: grab;
    user-select: none;
  }
  .filmv__strip::-webkit-scrollbar { display: none; }
  .filmv__strip.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .filmv__strip:focus-visible { outline: 2px solid #e8a33c; outline-offset: -2px; }
  .filmv__track { display: flex; gap: var(--space-4); width: max-content; padding-inline: var(--space-4); }
  .filmv__frame { position: relative; flex: none; scroll-snap-align: center; }
  .filmv__frame :global(img) { height: min(44vh, 28rem); width: auto; pointer-events: none; }
  .filmv__no {
    position: absolute;
    left: var(--space-2);
    bottom: -1.6rem;
    font-family: var(--font-system);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: #e8a33c;
  }
  @media (max-width: 40rem) {
    .filmv__hint { display: none; }
    .filmv__frame :global(img) { height: min(36vh, 20rem); }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-film-dialog]');
  if (dialog) {
    const strip = dialog.querySelector<HTMLElement>('[data-film-strip]')!;
    window.addEventListener('ina:shelf-open', (e) => {
      if ((e as CustomEvent).detail?.action?.kind !== 'film') return;
      strip.scrollLeft = 0;
      dialog.showModal();
      strip.focus();
    });
    dialog.querySelector('[data-film-close]')!.addEventListener('click', () => dialog.close());
    // Click on the dark around the film closes it too.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

    // A vertical wheel moves the film sideways.
    strip.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
      e.preventDefault();
      strip.scrollLeft += e.deltaY;
    }, { passive: false });
    // Arrow keys: one frame at a time.
    strip.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      strip.scrollBy({ left: (e.key === 'ArrowLeft' ? -1 : 1) * strip.clientWidth * 0.6, behavior: 'smooth' });
    });
    // Mouse drag (touch already scrolls natively).
    let down = false, x0 = 0, s0 = 0;
    strip.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      down = true; x0 = e.clientX; s0 = strip.scrollLeft;
      strip.setPointerCapture(e.pointerId);
      strip.classList.add('is-dragging');
    });
    strip.addEventListener('pointermove', (e) => { if (down) strip.scrollLeft = s0 - (e.clientX - x0); });
    const up = () => { down = false; strip.classList.remove('is-dragging'); };
    strip.addEventListener('pointerup', up);
    strip.addEventListener('pointercancel', up);
  }
</script>
