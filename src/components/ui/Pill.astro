---
// Pill: the only rounded thing on the site. A 1px ink outline (from the
// current portfolio's tags) with an optional mono glyph as its icon.
interface Props { glyph?: string; tone?: 'outline' | 'filled' | 'mark'; }
const { glyph, tone = 'outline' } = Astro.props;
---

<span class:list={['pill', `pill--${tone}`]}>
  {glyph && <span class="pill__glyph" aria-hidden="true">{glyph}</span>}
  <span><slot /></span>
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 2rem;
    padding: 0.2rem 0.85rem;
    border: var(--rule-ink);
    border-radius: var(--radius-pill);
    font-family: var(--font-system);
    font-size: var(--type-caption);
    line-height: 1.2;
    color: var(--color-ink);
    background: var(--color-paper);
    transition: background-color var(--duration-quick), translate var(--duration-quick) var(--ease-settle);
  }
  .pill__glyph {
    display: inline-grid;
    place-items: center;
    width: 1.25em;
    color: var(--color-accent);
    font-weight: 500;
  }
  .pill--filled { background: var(--color-ink); color: var(--color-paper); }
  .pill--filled .pill__glyph { color: var(--color-highlight); }
  .pill--mark { background: var(--color-highlight); color: var(--color-on-highlight); border-color: var(--color-on-highlight); }
  .pill:hover { translate: 0 -1px; }
</style>
