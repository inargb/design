---
// "Can you organize my shelf for me?" Drag with a pointer, or use the
// keyboard (Enter/Space puts an item away or takes it back). Without JS,
// the objects simply sit in a row next to the shelf.
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/config';
import { shelf } from '../content/about';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const u = shelf.ui;
const strings = Object.fromEntries(Object.entries(u).map(([k, v]) => [k, v[locale]]));
---

<div class="shelf" data-shelf data-slots={JSON.stringify(shelf.slots)} data-strings={JSON.stringify(strings)}>
  <p id="shelf-help" class="visually-hidden">{u.help[locale]}</p>
  <div class="shelf__stage" data-stage>
    <Image class="shelf__img" src={shelf.image} alt={shelf.imageAlt[locale]} widths={[500, 1000]} sizes="(max-width: 40rem) 100vw, 45vw" data-shelf-img />
    <div class="shelf__pile" data-pile></div>
    <ul class="shelf__objects" role="list" aria-describedby="shelf-help">
      {shelf.objects.map((o) => (
        <li class="shelf__item" data-id={o.id} data-size={o.size} data-home={o.home} data-pile={JSON.stringify(o.pile)} data-ratio={o.src.height / o.src.width}>
          <button type="button" class="shelf__obj" data-obj aria-label={o.name[locale]} data-cursor="drag" data-note={o.note[locale]}>
            <Image src={o.src} alt="" widths={[160, 320]} sizes="160px" draggable="false" />
          </button>
        </li>
      ))}
    </ul>
    <p class="shelf__note t-caption" data-note-bubble aria-hidden="true"></p>
    <div class="shelf__stars" data-stars aria-hidden="true"></div>
  </div>
  <!-- Under the pile, on the right: the lazy way out, then the count. -->
  <div class="shelf__bar">
    <button type="button" class="shelf__btn t-nav" data-tidy data-cursor="link">{u.tidy[locale]} <span aria-hidden="true">↺</span></button>
    <button type="button" class="shelf__btn t-nav" data-mess data-cursor="link" hidden>{u.mess[locale]} <span aria-hidden="true">↺</span></button>
    <p class="shelf__count t-meta" aria-hidden="true"><span data-count>0</span>/{shelf.objects.length}</p>
  </div>
  <p class="visually-hidden" aria-live="polite" data-shelf-live></p>
</div>

<style>
  .shelf { display: grid; gap: var(--space-4); }
  .shelf__stage {
    position: relative;
    display: grid;
    grid-template-columns: 52fr 48fr;
    align-items: end;
    padding-top: 13%;
  }
  /* The real photo: no filters, no blend modes. */
  .shelf__img { width: 100%; height: auto; user-select: none; pointer-events: none; }
  .shelf__pile { align-self: stretch; }

  /* No-JS / pre-JS: a simple row of objects. */
  .shelf__objects { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-4); }
  .shelf__obj { width: 5rem; padding: 0; border: 0; background: none; touch-action: none; }
  .shelf__obj :global(img) { width: 100%; height: auto; pointer-events: none; user-select: none; }

  /* JS on: objects float over the stage, positioned by the script. */
  .shelf.is-live .shelf__objects { position: absolute; inset: 0; margin: 0; display: block; pointer-events: none; }
  .shelf.is-live .shelf__item { position: absolute; left: 0; top: 0; pointer-events: auto; }
  .shelf.is-live .shelf__obj {
    display: block;
    width: var(--w);
    transform: translate(var(--x), var(--y)) rotate(var(--r, 0deg));
    transform-origin: 50% 100%;
    transition: transform var(--duration-slow) var(--ease-settle), opacity var(--duration-settle) var(--ease-soft);
    filter: drop-shadow(2px 3px 0 rgb(28 26 23 / 0.18));
  }
  /* Arriving: already in place, invisible; then a quick fade in. */
  .shelf.is-settling .shelf__obj { transition: none; opacity: 0; }
  .shelf.is-live .shelf__item.is-dragging .shelf__obj { transition: none; filter: drop-shadow(6px 10px 0 rgb(28 26 23 / 0.22)); z-index: 5; }
  .shelf.is-live .shelf__item.is-dragging { z-index: 10; }
  .shelf__obj:focus-visible { outline-offset: 4px; }

  .shelf__note {
    position: absolute;
    z-index: 20;
    left: 0;
    top: 0;
    max-width: 16rem;
    padding: var(--space-1) var(--space-2);
    background: var(--color-ink);
    color: var(--color-paper);
    pointer-events: none;
    opacity: 0;
    translate: -50% -100%;
    transition: opacity var(--duration-quick);
  }
  .shelf__note.is-on { opacity: 1; }

  /* Under the pile, right-aligned: "tidy up for me ↺   0/9". */
  .shelf__bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-6);
  }
  .shelf__count { color: var(--color-graphite); }
  .shelf__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--tap-min);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .shelf__btn:hover { color: var(--color-accent-hover); }
  .shelf__btn span { display: inline-block; transition: rotate var(--duration-settle) var(--ease-settle); }
  .shelf__btn:hover span { rotate: -180deg; }

  .shelf__stars { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .shelf__stars :global(i) {
    position: absolute;
    font-style: normal;
    color: var(--color-highlight);
    text-shadow: 0 0 6px rgb(243 207 28 / 0.8);
    animation: twinkle 2.6s var(--ease-soft) forwards;
  }
  @keyframes twinkle { 0% { opacity: 0; scale: 0.3; } 25% { opacity: 1; scale: 1; } 100% { opacity: 0; translate: 0 -30px; } }

  @media (max-width: 40rem) {
    .shelf__stage { grid-template-columns: 1fr; padding-top: 24%; }
    .shelf__pile { min-height: 70vw; }
  }
</style>

<script>
  import '../scripts/shelf';
</script>
