---
// The camera secret: a polaroid of a dog taking a selfie. Opened by the
// camera doodle in the footer (any device) or by typing "yashica". Write on
// it, pick a frame colour, save it to the device.
// Behaviour: src/scripts/polaroid.ts.
import '@fontsource/caveat/500.css';
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { dogs, frames } from '../content/dogs';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = ui.polaroid;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = JSON.stringify({
  dogs: dogs.map((d) => ({ ...d, src: `${base}/${d.src}` })),
  frames,
  photo: t.photo[locale],
  saved: t.saved[locale],
});
---

<dialog class="polaroid" aria-labelledby="polaroid-title" data-polaroid={data}>
  <button class="polaroid__close t-nav" type="button" data-polaroid-close>{t.close[locale]} ✕</button>
  <h2 id="polaroid-title" class="visually-hidden">{t.title[locale]}</h2>

  <div class="polaroid__stage">
    <figure class="polaroid__card" style={`--frame:${frames[0].hex};--frame-ink:${frames[0].ink}`} data-polaroid-card>
      <div class="polaroid__photo">
        <img alt={t.alt[locale]} data-polaroid-img />
      </div>
      <label class="visually-hidden" for="polaroid-caption">{t.caption[locale]}</label>
      <input id="polaroid-caption" class="polaroid__caption" type="text" maxlength="32" autocomplete="off" placeholder={t.placeholder[locale]} data-polaroid-caption />
    </figure>
    <p class="polaroid__credit t-caption"><a data-polaroid-credit target="_blank" rel="noopener"></a></p>

    <fieldset class="polaroid__frames">
      <legend class="t-label">{t.frame[locale]}</legend>
      <div class="polaroid__swatches">
        {frames.map((f, i) => (
          <label class="polaroid__swatch" style={`--swatch:${f.hex}`}>
            <input class="visually-hidden" type="radio" name="polaroid-frame" value={f.id} checked={i === 0} data-polaroid-frame />
            <span aria-hidden="true"></span>
            <span class="visually-hidden">{f.name[locale]}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="polaroid__actions">
      <button class="polaroid__btn polaroid__btn--ink" type="button" data-polaroid-save>{t.save[locale]} ↓</button>
    </div>
    <p class="polaroid__status t-caption" role="status" aria-live="polite" data-polaroid-status></p>
  </div>
</dialog>

<style>
  .polaroid {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: calc(var(--tap-min) + var(--space-8)) var(--layout-gutter) var(--space-6);
    border: 0;
    background: transparent;
    overflow-y: auto;
  }
  .polaroid::backdrop { background: rgb(20 18 16 / 0.78); }
  .polaroid[open] { display: flex; flex-direction: column; align-items: center; justify-content: safe center; }
  .polaroid__close {
    position: fixed;
    top: var(--space-4);
    right: var(--layout-gutter);
    min-height: var(--tap-min);
    padding: 0 var(--space-3);
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: var(--shadow-offset);
  }
  .polaroid__stage { display: grid; justify-items: center; gap: var(--space-3); width: 100%; }
  /* The print shrinks to leave room for the controls on short screens. */
  .polaroid__card { --w: min(clamp(12rem, calc((100svh - 22rem) * 0.82), 22rem), 100%); width: var(--w); padding: calc(var(--w) * 0.06) calc(var(--w) * 0.06) 0; }

  /* The print: thin sides, deep chin, a hair off straight. */
  .polaroid__card {
    margin: 0;
    background: var(--frame);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.08), 6px 8px 0 rgb(0 0 0 / 0.28);
    rotate: -2deg;
    transition: background var(--duration-settle) var(--ease-soft);
  }
  .polaroid__photo { aspect-ratio: 1; overflow: hidden; background: #2a2723; }
  .polaroid__photo img { width: 100%; height: 100%; object-fit: cover; }
  /* Develops: a pale, milky print that comes up to full tone. */
  .polaroid.is-developing .polaroid__photo img { filter: grayscale(0.9) brightness(1.9) contrast(0.4) sepia(0.3); opacity: 0.25; }
  .polaroid.is-developed .polaroid__photo img {
    transition: filter 3.2s var(--ease-develop, ease-out), opacity 1.6s ease-out;
  }
  .polaroid__caption {
    display: block;
    width: 100%;
    height: 4.6rem;
    padding: 0 var(--space-2);
    border: 0;
    background: transparent;
    color: var(--frame-ink);
    font-family: 'Caveat', cursive;
    font-size: 1.9rem;
    font-weight: 500;
    text-align: center;
  }
  .polaroid__caption::placeholder { color: var(--frame-ink); opacity: 0.45; }
  .polaroid__caption:focus-visible { outline: 2px dashed var(--frame-ink); outline-offset: -8px; }

  .polaroid__status { min-height: 1.4em; color: #fbfbfd; text-align: center; }
  .polaroid__credit { color: #fbfbfd; opacity: 0.85; }
  .polaroid__credit a { color: inherit; }

  .polaroid__frames { display: grid; justify-items: center; gap: var(--space-2); margin: 0; padding: var(--space-3) var(--space-4); border: 0; background: var(--color-paper); box-shadow: var(--shadow-offset); }
  .polaroid__frames legend { float: left; width: 100%; text-align: center; color: var(--color-graphite); }
  .polaroid__swatches { display: flex; gap: var(--space-2); }
  .polaroid__swatch { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; }
  .polaroid__swatch span[aria-hidden] { width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--swatch); border: 1px solid var(--color-ink); }
  .polaroid__swatch input:checked + span { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .polaroid__swatch input:focus-visible + span { outline: 2px solid var(--color-focus); outline-offset: 3px; }

  .polaroid__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); }
  .polaroid__btn {
    min-height: var(--tap-min);
    padding: 0 var(--space-4);
    border: var(--rule-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-system);
    font-size: var(--type-meta);
    box-shadow: 0 2px 0 var(--color-ink);
  }
  .polaroid__btn:hover { background: var(--color-highlight); }
  .polaroid__btn:active { translate: 0 2px; box-shadow: none; }
  .polaroid__btn--ink { background: var(--color-ink); color: var(--color-paper); }
  .polaroid__btn--ink:hover { background: var(--color-accent); }
  .polaroid__btn:disabled { opacity: 0.7; }

  @media (prefers-reduced-motion: reduce) {
    .polaroid.is-developing .polaroid__photo img { filter: none; opacity: 1; }
    .polaroid__card { transition: none; }
  }
</style>
