---
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { site } from '../content/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const f = ui.footer;
const links = [
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'Instagram', href: site.links.instagram },
  { label: ui.nav.resume[locale], href: site.links.resume[locale] },
  { label: f.design[locale], href: site.links.design },
];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__top">
    <p class="footer__hello t-heading-l">{f.greeting[locale]}</p>
    <ul class="footer__links" role="list" aria-label={f.elsewhere[locale]}>
      {links.map((l) => (
        <li>
          <a class="footer__link" href={l.href} target="_blank" rel="noopener">
            {l.label}<span aria-hidden="true">&thinsp;↗</span>
            <span class="visually-hidden">{ui.nav.newTab[locale]}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <p class="footer__base t-meta">© {year} {site.name} · {f.signature[locale]}</p>
</footer>

<style>
  .footer {
    margin-top: var(--section-space);
    padding-block: var(--space-12) var(--space-8);
    border-top: var(--rule-hair);
  }
  .footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4) var(--space-8);
  }
  .footer__links { display: flex; flex-wrap: wrap; gap: 0 var(--space-6); }
  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-size: var(--type-body-s);
    color: var(--color-graphite);
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-soft);
  }
  .footer__link:hover { color: var(--color-ink); }
  .footer__base { margin-top: var(--space-8); }
  @media (max-width: 40rem) {
    .footer { padding-bottom: calc(var(--space-12) + env(safe-area-inset-bottom)); }
  }
</style>
