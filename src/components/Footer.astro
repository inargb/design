---
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { site } from '../content/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const f = ui.footer;
const c = ui.controls;
const links = [
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'Instagram', href: site.links.instagram },
  { label: ui.nav.resume[locale], href: site.links.resume[locale] },
  { label: 'Design', href: site.links.design },
];
---

<footer class="footer">
  <div class="container">
    <!-- The greeting on one end, the links on the other (stacked on phones). -->
    <div class="footer__top">
      <p class="footer__hello t-heading-xl">
        {f.greeting[locale]}<span class="caret" aria-hidden="true"></span>
      </p>

      <div class="footer__mid">
        <ul class="footer__links" role="list" aria-label={f.elsewhere[locale]}>
          {links.map((l) => (
            <li>
              <a class="footer__link" href={l.href} target="_blank" rel="noopener">
                {l.label}<span aria-hidden="true"> ↗</span>
                <span class="visually-hidden">{ui.nav.newTab[locale]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer__base t-meta">
      <p class="footer__sig">{f.signature[locale]}</p>
      <div class="footer__controls" role="group" aria-label={c.group[locale]}>
        <button class="footer__ctl" type="button" aria-pressed="false" data-spec-toggle aria-label={c.spec[locale]} title={c.spec[locale]}>
          <svg class="footer__ico footer__ruler" viewBox="0 0 24 8" aria-hidden="true">
            <rect x="0.5" y="0.5" width="23" height="7" fill="none" stroke="currentColor" />
            <path d="M4 1v3M8 1v4M12 1v3M16 1v4M20 1v3" stroke="currentColor" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Paper like the page, everything in ink. */
  .footer {
    margin-top: var(--section-space);
    padding-block: var(--space-16) var(--space-8);
    border-top: var(--rule-hair);
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
  }
  .footer__hello { max-width: 12ch; }
  .footer__mid {
    display: flex;
    gap: 0 var(--space-6);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .footer__links { display: flex; flex-wrap: wrap; gap: 0 var(--space-8); }
  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-family: var(--font-body);
    font-size: var(--type-body);
    color: var(--color-ink);
    text-decoration: none;
  }
  .footer__link:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: var(--rule-hair);
  }
  /* Flush right: the ruler lines up with the end of the links above. */
  .footer__controls { display: flex; gap: var(--space-1); margin-left: auto; margin-right: calc(-1 * var(--space-3)); }
  .footer__ctl {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    padding: 0 var(--space-3);
    border: 0;
    background: none;
    color: var(--color-ink);
    font-family: var(--font-system);
    font-size: var(--type-meta);
  }
  .footer__ctl[aria-pressed='true'] .footer__ico { color: var(--color-accent); }
  .footer__ruler { width: 1.5rem; }

  @media (max-width: 40rem) {
    .footer { padding-bottom: calc(var(--space-12) + env(safe-area-inset-bottom)); }
    .footer__top { flex-direction: column; align-items: flex-start; gap: var(--space-8); }
  }
</style>

<script>
  import '../scripts/spec-mode';
</script>
