---
// A project's cover: an uploaded still or a looping video.
//   · the frame's shape comes from --cover-ratio (set by the context)
//   · media fills it with object-fit: cover, centred on the cover's `focus`
//     and zoomed by `zoom`, so the subject survives every crop
//   · stills use srcset (800w / 1600w); videos load only near the viewport,
//     play only while visible, and show the poster with reduced motion
import type { CoverMedia } from '../content/projects';
import type { Locale } from '../i18n/config';
import { withBase } from '../i18n/config';

interface Props {
  label: string;          // '' when the title sits next to the cover (decorative)
  media: CoverMedia;
  locale?: Locale;
  sizes?: string;         // how wide the cover renders, for srcset
}
const { label, media, locale = 'en', sizes = '(max-width: 40rem) 100vw, 50vw' } = Astro.props;
const alt = label ? media.alt[locale] ?? label : '';
const style = `--focus:${media.focus ?? '50% 50%'};--zoom:${media.zoom ?? 1}`;
---

<div class="media-cover" style={style} data-cover data-media-cover>
  {media.video ? (
    <video muted loop playsinline preload="none" poster={media.poster && withBase(media.poster)} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'} disablepictureinpicture>
      <source src={withBase(media.video.webm)} type="video/webm" />
      <source src={withBase(media.video.mp4)} type="video/mp4" />
    </video>
  ) : media.image ? (
    <img
      src={withBase(media.image.src)}
      srcset={`${withBase(media.image.small)} 800w, ${withBase(media.image.src)} 1600w`}
      sizes={sizes}
      alt={alt}
      width="1600"
      height="900"
      loading="lazy"
      decoding="async"
    />
  ) : null}
</div>

<style>
  .media-cover {
    position: relative;
    aspect-ratio: var(--cover-ratio, 16 / 9);
    overflow: hidden;
    background: var(--color-paper-shade);
  }
  .media-cover :is(video, img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
    transform: scale(var(--zoom));
    transform-origin: var(--focus);
  }
</style>

<script>
  import { motionOn } from '../scripts/prefs';

  // Videos start loading when they come near the viewport and play only
  // while visible, with motion on.
  const covers = document.querySelectorAll<HTMLElement>('[data-cover]');
  const visible = new Set<HTMLElement>();

  function sync(el: HTMLElement) {
    el.toggleAttribute('data-inview', visible.has(el));
    const video = el.querySelector('video');
    if (!video) return;
    if (visible.has(el) && motionOn()) {
      if (video.preload === 'none') { video.preload = 'auto'; video.load(); }
      video.play().catch(() => {});
    } else {
      video.pause();
    }
  }

  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const el = e.target as HTMLElement;
        if (e.isIntersecting) visible.add(el); else visible.delete(el);
        sync(el);
      }
    }, { threshold: 0.25 });
    covers.forEach((c) => io.observe(c));
  }
  window.addEventListener('ina:prefs', () => covers.forEach(sync));
</script>
