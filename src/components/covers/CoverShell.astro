---
// Shared shell for project covers: frame shape from --cover-ratio (4:3 by default), container-query units
// inside so each cover scales from a thumbnail to a case-study hero.
// Animations only run while the cover is on screen (data-inview) and
// stop entirely when motion is off, leaving a composed still frame.
interface Props { bg: string; ink: string; label: string; }
const { bg, ink, label } = Astro.props;
// An empty label means the cover sits next to its own title: hide it from AT.
---

<div class="cover" style={`--cover-bg:${bg};--cover-ink:${ink}`} role={label ? 'img' : undefined} aria-label={label || undefined} aria-hidden={label ? undefined : 'true'} data-cover>
  <slot />
</div>

<style>
  .cover {
    --play: paused;
    position: relative;
    container-type: inline-size;
    aspect-ratio: var(--cover-ratio, 4 / 3);
    overflow: hidden;
    background: var(--cover-bg);
    color: var(--cover-ink);
    font-family: var(--font-system);
    isolation: isolate;
  }
  .cover[data-inview] { --play: running; }
  .cover :global(*) { animation-play-state: var(--play) !important; }
  @media (prefers-reduced-motion: reduce) {
    .cover :global(*) { animation: none !important; }
  }
</style>
