---
// Sabi (coming soon): a dish becomes a question. Ingredients orbit a plate;
// one is picked out and turned into the right allergen question.
// The three bars + yellow dot echo Sabi's own mark.
import CoverShell from './CoverShell.astro';
interface Props { label: string; }
const chips = ['sesame', 'peanut', 'milk', 'egg', 'wheat', 'soy'];
---

<CoverShell bg="#161616" ink="#f2efe8" label={Astro.props.label}>
  <div class="sabi">
    <div class="sabi__mark" aria-hidden="true"><i></i><i class="dot"></i><i></i></div>
    <div class="sabi__plate">
      <div class="sabi__orbit">
        {chips.map((c, i) => <span style={`--a:${i * 60}deg`}>{c}</span>)}
      </div>
    </div>
    <p class="sabi__q">does this have <b>sesame</b>?</p>
  </div>
</CoverShell>

<style>
  .sabi { position: absolute; inset: 0; font-size: 1.5cqw; }
  .sabi__mark { position: absolute; left: 6cqw; top: 6cqw; display: grid; gap: 0.9cqw; width: 9cqw; }
  .sabi__mark i { height: 1.8cqw; border-radius: 1cqw; background: #f2efe8; }
  .sabi__mark .dot { width: 3cqw; height: 3cqw; border-radius: 50%; background: #f3cf1c; justify-self: center; margin-block: -0.6cqw; }

  .sabi__plate {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 30cqw;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    border: 0.25cqw solid #f2efe8;
    box-shadow: inset 0 0 0 3cqw #161616, inset 0 0 0 3.25cqw rgb(242 239 232 / 0.4);
  }
  .sabi__orbit { position: absolute; inset: 0; animation: orbit 18s linear infinite; }
  .sabi__orbit span {
    position: absolute;
    left: 50%;
    top: 50%;
    padding: 0.5cqw 1.2cqw;
    border-radius: 99px;
    border: 0.15cqw solid rgb(242 239 232 / 0.6);
    background: #161616;
    white-space: nowrap;
    translate: -50% -50%;
    transform: rotate(var(--a)) translateY(-21cqw) rotate(calc(-1 * var(--a)));
  }
  .sabi__orbit span:first-child { background: #f3cf1c; color: #161616; border-color: #f3cf1c; }
  @keyframes orbit { to { rotate: 360deg; } }
  .sabi__orbit span { animation: counter 18s linear infinite; }
  @keyframes counter { to { rotate: -360deg; } }

  .sabi__q {
    position: absolute;
    right: 5cqw;
    bottom: 5cqw;
    margin: 0;
    padding: 1.2cqw 2cqw;
    font-family: var(--font-title);
    font-size: 2.6cqw;
    background: #f2efe8;
    color: #161616;
    border-radius: 2cqw 2cqw 0.3cqw 2cqw;
    animation: ask 6s var(--ease-settle) infinite;
  }
  .sabi__q b { background: #f3cf1c; font-weight: 500; padding-inline: 0.3cqw; }
  @keyframes ask { 0%, 30% { opacity: 0; translate: 0 1.5cqw; } 40%, 90% { opacity: 1; translate: 0 0; } 100% { opacity: 0; } }
</style>
