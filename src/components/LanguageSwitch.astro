---
// Two languages, one link: it names the other language.
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props { locale: Locale; altHref: string; }
const { locale, altHref } = Astro.props;
const other: Locale = locale === 'en' ? 'pt' : 'en';
---

<a
  class="lang"
  href={altHref}
  hreflang={other === 'pt' ? 'pt-BR' : 'en'}
  lang={other === 'pt' ? 'pt-BR' : 'en'}
  aria-label={ui.lang.switchTo[locale]}
>
  <span aria-hidden="true">{other === 'pt' ? 'PT' : 'EN'}</span>
</a>

<style>
  .lang {
    display: inline-grid;
    place-items: center;
    min-width: var(--tap-min);
    min-height: var(--tap-min);
    margin-right: calc(-1 * var(--space-3));
    font-size: var(--type-caption);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-graphite-soft);
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-soft);
  }
  .lang:hover { color: var(--color-ink); }
</style>
