---
// The work: a two-column grid of landscape covers (one column on phones).
// Each card says only: name / context · year.
// Open projects link to their case; protected ones open the password gate;
// projects still in progress are shown, quieter, without a link. Over a
// card, the pointer becomes a viewfinder that says what a click does.
import ProjectCover from './ProjectCover.astro';
import ProjectCursor from './ProjectCursor.astro';
import { caseHref, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { projects } from '../content/projects';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = ui.project;

// "2024 — 2026" → "2024–2026"
const year = (v: string) => (v === '—' ? '' : v.replace(/\s*—\s*/g, '–'));
---

<ul class="work-grid" role="list" data-stagger>
  {projects.map((proj) => {
    const Tag = proj.state === 'soon' ? 'div' : 'a';
    const linkProps = proj.state === 'soon' ? {} : { href: caseHref(proj.slug, locale) };
    const meta = [proj.context[locale], year(proj.period[locale])].filter(Boolean).join(' · ');
    return (
      <li class="card" data-state={proj.state} data-reveal>
        <Tag class="card__hit" {...linkProps} data-pcursor-host={proj.state}>
          <div class="card__cover">
            <ProjectCover media={proj.media} label="" locale={locale} sizes="(max-width: 40rem) 100vw, (max-width: 72rem) 50vw, 36rem" />
          </div>
          <h3 class="card__title">
            <span class="card__name">{proj.title[locale]}</span>
            {proj.state === 'locked' && (
              <svg class="card__lock" viewBox="0 0 12 14" aria-hidden="true"><rect x="1.5" y="6" width="9" height="7" rx="1.2" /><path d="M3.5 6V4.2a2.5 2.5 0 0 1 5 0V6" /></svg>
            )}
            <span class="card__sep" aria-hidden="true">/</span>
            <span class="card__meta">{meta}</span>
            {proj.state === 'locked' && <span class="visually-hidden"> ({p.locked[locale]})</span>}
            {proj.state === 'soon' && <span class="visually-hidden"> ({p.soon[locale]})</span>}
          </h3>
        </Tag>
      </li>
    );
  })}
</ul>
<ProjectCursor locale={locale} />

<style>
  .work-grid {
    --cover-ratio: 16 / 10;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12) var(--layout-gap);
  }
  @media (max-width: 40rem) {
    .work-grid { grid-template-columns: 1fr; }
  }

  .card__hit {
    display: grid;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
  }
  .card__cover {
    overflow: hidden;
    border: var(--rule-hair);
    border-radius: var(--radius-soft);
    background: var(--color-paper-shade);
  }
  .card__cover :global(.media-cover) { transition: scale var(--duration-slow) var(--ease-settle); }
  a.card__hit:hover .card__cover :global(.media-cover) { scale: 1.015; }
  .card__hit:focus-visible { outline: none; }
  .card__hit:focus-visible .card__cover { outline: 2px solid var(--color-focus); outline-offset: 3px; }

  .card__title {
    font-family: var(--font-body);
    font-size: var(--type-body-s);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .card__lock { display: inline-block; width: 0.7em; height: 0.8em; margin-left: 0.35em; vertical-align: -0.05em; fill: none; stroke: currentColor; stroke-width: 1.3; }
  .card__sep { margin-inline: 0.4em; color: var(--color-rule); font-weight: 400; }
  .card__meta { color: var(--color-graphite-soft); font-weight: 400; }
  a.card__hit:hover .card__name { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }

  /* In progress: quieter, not a link. */
  .card[data-state='soon'] .card__cover :global(.media-cover) { opacity: 0.55; filter: grayscale(0.6); }
</style>
