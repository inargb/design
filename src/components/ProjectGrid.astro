---
// The work: a two-column grid of covers (one column on phones). Every card
// answers the same questions in the same place: cover · title / context ·
// a one-line description · role, period and status.
// Open projects link to their case; protected ones open the password gate;
// projects still in progress are shown, quieter, without a link.
import ProjectCover from './ProjectCover.astro';
import { caseHref, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { projects } from '../content/projects';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = ui.project;
const known = (v: string) => v !== '—';
---

<ul class="work-grid" role="list" data-stagger>
  {projects.map((proj) => {
    const Tag = proj.state === 'soon' ? 'div' : 'a';
    const linkProps = proj.state === 'soon' ? {} : { href: caseHref(proj.slug, locale) };
    const meta = [proj.role[locale], proj.period[locale]].filter(known);
    return (
      <li class="card" data-state={proj.state} data-reveal>
        <Tag class="card__hit" {...linkProps}>
          <div class="card__cover">
            <ProjectCover media={proj.media} label="" locale={locale} sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 29rem" />
          </div>
          <div class="card__text">
            <h3 class="card__title">
              <span class="card__name">{proj.title[locale]}</span>
              <span class="card__sep" aria-hidden="true">/</span>
              <span class="card__context">{proj.context[locale]}</span>
            </h3>
            <p class="card__line">{proj.line[locale]}</p>
            <p class="card__meta">
              {meta.length > 0 && <span>{meta.join(' · ')}</span>}
              {proj.state === 'locked' && (
                <span class="card__flag">
                  <svg viewBox="0 0 12 14" aria-hidden="true"><rect x="1.5" y="6" width="9" height="7" rx="1" /><path d="M3.5 6V4a2.5 2.5 0 0 1 5 0v2" /></svg>
                  {p.locked[locale]}
                </span>
              )}
              {proj.state === 'soon' && <span class="card__flag">{p.soon[locale]}</span>}
            </p>
          </div>
        </Tag>
      </li>
    );
  })}
</ul>

<style>
  .work-grid {
    --cover-ratio: 4 / 3;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16) var(--layout-gap);
  }
  @media (max-width: 40rem) {
    .work-grid { grid-template-columns: 1fr; gap: var(--space-12); }
  }

  .card__hit {
    display: grid;
    gap: var(--space-4);
    color: inherit;
    text-decoration: none;
  }
  .card__cover {
    overflow: hidden;
    border: var(--rule-hair);
    border-radius: var(--radius-soft);
    background: var(--color-paper-shade);
  }
  .card__cover :global(.media-cover) { transition: scale var(--duration-slow) var(--ease-settle); }
  a.card__hit:hover .card__cover :global(.media-cover) { scale: 1.015; }
  .card__hit:focus-visible { outline: none; }
  .card__hit:focus-visible .card__cover { outline: 2px solid var(--color-focus); outline-offset: 3px; }

  .card__text { display: grid; gap: var(--space-2); }
  .card__title {
    font-family: var(--font-body);
    font-size: var(--type-body);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .card__sep { margin-inline: 0.35em; color: var(--color-rule); font-weight: 400; }
  .card__context { color: var(--color-graphite-soft); font-weight: 400; }
  a.card__hit:hover .card__name { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  .card__line { max-width: 34rem; font-size: var(--type-body-s); line-height: 1.55; color: var(--color-graphite); text-wrap: pretty; }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    font-size: var(--type-caption);
    color: var(--color-graphite-soft);
  }
  .card__flag { display: inline-flex; align-items: center; gap: 0.4em; }
  .card__flag svg { width: 0.7rem; fill: none; stroke: currentColor; stroke-width: 1.2; }

  /* In progress: quieter, not a link. */
  .card[data-state='soon'] .card__cover :global(.media-cover) { opacity: 0.55; filter: grayscale(0.6); }
</style>
