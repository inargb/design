  }
  .cb-card--compare.is-after .cb-compare__label { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }
  .cb-compare__rows { display: grid; gap: var(--space-3); }
  .cb-compare__rows div { display: grid; gap: 2px; padding-bottom: var(--space-3); border-bottom: var(--rule-hair); }
  .cb-compare__rows div:last-child { border-bottom: 0; padding-bottom: 0; }
  .cb-compare__rows dt { font-family: var(--font-system); font-size: var(--type-meta); letter-spacing: 0.04em; color: var(--color-graphite-soft); }
  .cb-compare__rows dd { font-size: var(--type-body); color: var(--color-graphite-soft); }
  .cb-card--compare.is-after dd { color: var(--color-ink); font-weight: 500; }
  .cb-gallery__no { font-family: var(--font-system); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-ink); }

  /* Image slots: the shape and place of an image still to come. */
  .cb-slots { display: grid; gap: var(--space-3); margin: 0; }
  .cb-slots__row { display: flex; align-items: flex-start; gap: var(--space-4); }
  .cb-slots__row li { min-width: 0; }
  .cb-slot {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--color-paper-shade);
    border: 1px dashed var(--color-rule);
    overflow: hidden;
  }
  .cb-slot__id, .cb-slot__soon { font-family: var(--font-system); font-size: var(--type-meta); letter-spacing: 0.04em; color: var(--color-graphite); }
  .cb-slot__soon { justify-self: end; }
  .cb-slot__alt { align-self: center; max-width: 42ch; justify-self: center; text-align: center; font-size: var(--type-body-s); line-height: 1.45; color: var(--color-graphite); text-wrap: pretty; overflow: hidden; }
  .cb-slots__row li:not(:only-child) .cb-slot__alt { font-size: var(--type-meta); }

  .cb-table { overflow-x: auto; }
  .cb-table table { width: 100%; border-collapse: collapse; }
  .cb-table caption { text-align: left; padding-bottom: var(--space-3); }
  .cb-table th, .cb-table td { padding: var(--space-3) var(--space-4) var(--space-3) 0; text-align: left; vertical-align: top; border-bottom: var(--rule-hair); }
  .cb-table thead th { color: var(--color-graphite); border-bottom: var(--rule-ink); }
  .cb-table tbody th { width: 34%; font-weight: 500; color: var(--color-ink); }
  .cb-table td { color: var(--color-graphite); line-height: var(--leading-body); }
  .cb-table tr.is-muted th, .cb-table tr.is-muted td { color: var(--color-graphite-soft); font-style: italic; }

  /* Scrolls sideways; the right edge fades so it reads as “more this way”. */
  .cb-timeline { overflow-x: auto; padding-block: var(--space-6) var(--space-3); mask-image: linear-gradient(to right, #000 88%, transparent); }
  .cb-timeline__line { position: relative; display: flex; width: max-content; padding-right: 4rem; }
  .cb-timeline__line::before { content: ''; position: absolute; left: 0; right: 0; top: 0.35rem; border-top: var(--rule-ink); }
  .cb-timeline__item { position: relative; display: grid; align-content: start; gap: var(--space-1); width: 8.5rem; padding: var(--space-6) var(--space-3) 0 0; }
  .cb-timeline__item::before { content: ''; position: absolute; top: 0; left: 0; width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--color-paper); border: 1px solid var(--color-ink); }
  .cb-timeline__date { color: var(--color-accent); }
  .cb-timeline__topic { font-size: var(--type-body-s); line-height: 1.4; color: var(--color-ink); }
  .cb-timeline__marker { position: relative; width: 0; margin-right: var(--space-4); }
  .cb-timeline__marker::before { content: ''; position: absolute; top: calc(-1 * var(--space-6)); bottom: calc(-1 * var(--space-2)); left: 0; border-left: 1.5px dashed var(--color-accent); }
  .cb-timeline__marker span { position: absolute; top: calc(-1 * var(--space-6)); left: var(--space-2); white-space: nowrap; color: var(--color-accent); }

  .cb-defs { display: grid; gap: var(--space-4); }
  .cb-defs__title { color: var(--color-ink); text-wrap: balance; max-width: 30ch; }
  .cb-defs__rows { display: grid; }
  .cb-defs__rows div { display: grid; grid-template-columns: 9rem 1fr; gap: var(--space-4); padding-block: var(--space-3); border-top: var(--rule-hair); }
  .cb-defs__rows div:last-child { border-bottom: var(--rule-hair); }
  .cb-defs__rows dt { padding-top: 0.3em; color: var(--color-graphite); }
  .cb-defs__rows dd { font-size: var(--type-body); line-height: var(--leading-body); color: var(--color-ink); max-width: 62ch; }

  .cb-cards-wrap { display: grid; gap: var(--space-4); }
  .cb-card--plain { min-height: 0; }
  .cb-card__pill { align-self: flex-start; margin-top: auto; padding: 2px var(--space-2); border: 1px solid var(--color-ink); font-family: var(--font-system); font-size: var(--type-meta); color: var(--color-ink); }
  .cb-cards__loop { justify-self: start; padding: var(--space-1) var(--space-3); border: 1px dashed var(--color-accent); color: var(--color-accent); }

  .cb-pull { max-width: 28ch; padding-left: var(--space-6); border-left: 3px solid var(--color-accent); color: var(--color-ink); text-wrap: balance; }

  .cb-map { position: relative; aspect-ratio: 16 / 9; margin: 0; }
  .cb-map__lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cb-map__lines line { stroke: var(--color-rule); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .cb-map__center {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    padding: var(--space-3) var(--space-5, 1.25rem);
    background: var(--color-ink); color: var(--color-paper);
  }
  .cb-map__items li {
    position: absolute; left: var(--x); top: var(--y); translate: -50% -50%;
    max-width: 11rem; padding: var(--space-1) var(--space-3);
    background: var(--color-paper); border: 1px solid var(--color-ink);
    font-size: var(--type-body-s); line-height: 1.35; text-align: center; color: var(--color-ink);
  }

  @media (max-width: 64rem) {
    .cb-cards--4, .cb-cards--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cb-cards--compare { grid-template-columns: 1fr; }
    .cb-card { min-height: 0; }
  }
  @media (max-width: 40rem) {
    .cb-slots__row { flex-direction: column; }
    .cb-slots__row li { width: 100%; }
    .cb-defs__rows div { grid-template-columns: 1fr; gap: var(--space-1); }
    .cb-map { aspect-ratio: auto; display: grid; gap: var(--space-3); }
    .cb-map__lines { display: none; }
    .cb-map__center { position: static; translate: none; justify-self: start; }
    .cb-map__items { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .cb-map__items li { position: static; translate: none; max-width: none; text-align: left; }
  }
  @media (max-width: 40rem) {
    .cb-cards--4, .cb-cards--3 { grid-template-columns: 1fr; }
    .cb-gallery__row { flex-direction: column; }
    .cb-gallery__row li { width: 100%; }
    .cb-cards { gap: var(--space-8); padding-inline: var(--space-2); }
    .cb-question { padding: var(--space-6); }
  }

  /* Figures (components/case/CaseFigure.astro) */
  .cfig { display: grid; gap: var(--space-3); margin: 0; }
  .cfig__print {
    display: block;
    width: 100%;
    padding: 0;
    border: var(--rule-hair);
    background: var(--color-paper-shade);
    cursor: zoom-in;
  }
  .cfig__print img, .cfig__print picture { display: block; width: 100%; height: auto; }
  .cfig__print--video { cursor: default; }
  .cfig__print video { display: block; width: 100%; height: auto; }
  @media (prefers-reduced-motion: reduce) { .cfig__print video { pointer-events: auto; } }
  .cfig__print:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 4px; }
  .cfig__cap { max-width: var(--layout-text); text-wrap: pretty; }
  .cfig__no { font-family: var(--font-system); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-ink); }
</style>

<script>
  import { motionOn } from '../../scripts/prefs';

  // Marquee rows: drift on their own, move by hand, loop seamlessly.
  // Runs on load and again when a sealed case is opened (ina:case-content).
  const RESUME_AFTER = 1800;
  function initMarquees(root: ParentNode = document) {
  root.querySelectorAll<HTMLElement>('[data-mq-row]:not([data-mq-ready])').forEach((row) => {
    row.dataset.mqReady = '';
    const track = row.firstElementChild as HTMLElement;
    const dir = row.dataset.dir === 'right' ? -1 : 1;
    const speed = Number(row.dataset.speed) || 35;   // px per second
    let loop = 0;                                     // one copy + one gap
    let pos = 0;                                      // float scroll position
    let idleUntil = 0, onScreen = false, raf = 0, last = 0, hover = false;

    const measure = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      loop = (track.scrollWidth + gap) / 2;
    };
    const wrap = () => {
      if (!loop) return;
      if (row.scrollLeft >= loop) row.scrollLeft -= loop;
      else if (row.scrollLeft <= 0) row.scrollLeft += loop;
      pos = row.scrollLeft;
    };
    const touch = () => { idleUntil = performance.now() + RESUME_AFTER; };

    function tick(now: number) {
      const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
      last = now;
      if (motionOn() && !hover && now > idleUntil && loop) {
        pos += dir * speed * dt;
        if (pos >= loop) pos -= loop;
        if (pos <= 0) pos += loop;
        row.scrollLeft = pos;
      }
      raf = onScreen ? requestAnimationFrame(tick) : 0;
    }

    // By hand: native scroll (touch, trackpad, keys) + mouse drag.
    row.addEventListener('scroll', () => { if (performance.now() < idleUntil || hover) wrap(); }, { passive: true });
    ['wheel', 'touchstart', 'keydown'].forEach((ev) => row.addEventListener(ev, touch, { passive: true }));
    row.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hover = true; });
    row.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { hover = false; touch(); } });
    let dragging = false, px = 0;
    row.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      dragging = true; px = e.clientX; row.setPointerCapture(e.pointerId); row.classList.add('is-dragging');
    });
    row.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      row.scrollLeft -= e.clientX - px; px = e.clientX; wrap(); touch();
    });
    const end = () => { dragging = false; row.classList.remove('is-dragging'); touch(); };
    row.addEventListener('pointerup', end);
    row.addEventListener('pointercancel', end);
    row.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault(); row.scrollBy({ left: e.key === 'ArrowLeft' ? -240 : 240, behavior: 'smooth' });
    });

    new ResizeObserver(() => { measure(); if (!pos && loop) { pos = dir < 0 ? loop : 1; row.scrollLeft = pos; } }).observe(track);
    new IntersectionObserver(([en]) => {
      onScreen = en.isIntersecting;
      if (onScreen && !raf) { last = 0; raf = requestAnimationFrame(tick); }
    }).observe(row);
  });
  }
  initMarquees();
  window.addEventListener('ina:case-content', (e) => initMarquees((e as CustomEvent).detail?.root ?? document));

  // Videos: with reduced motion, hold the first frame (tap to play).
  function calmVideos(root: ParentNode = document) {
    if (motionOn()) return;
    root.querySelectorAll<HTMLVideoElement>('.cfig__print video').forEach((v) => { v.pause(); v.removeAttribute('autoplay'); v.controls = true; });
  }
  calmVideos();
  window.addEventListener('ina:case-content', (e) => calmVideos((e as CustomEvent).detail?.root ?? document));
</script>
