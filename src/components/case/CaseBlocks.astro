---
// Renders one section's blocks. Every block type in content/cases/types.ts
// has a branch here, so cases are content only.
import { Image } from 'astro:assets';
import CaseFigure from './CaseFigure.astro';
import { figures } from './figures';
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import type { CaseBlock } from '../../content/cases/types';

interface Props { blocks: CaseBlock[]; locale: Locale; figStart: number; }
const { blocks, locale, figStart } = Astro.props;
// Figure numbers run through the whole case.
let fig = figStart;
const numbered = blocks.map((b) => {
  const first = fig;
  fig += figures(b);
  return { b, first };
});
const two = (i: number) => String(i + 1).padStart(2, '0');
// Cards sit like notes on a table: each a hair off straight.
const tilt = (i: number) => [-1.1, 0.5, -0.4, 0.9][i % 4];
// Line icons, 24×24, stroke = currentColor.
const icons: Record<string, string> = {
  layout: '<rect x="3.5" y="3.5" width="17" height="7" rx="2"/><rect x="3.5" y="13.5" width="7.5" height="7" rx="2"/><rect x="13" y="13.5" width="7.5" height="7" rx="2"/>',
  search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 20.5 20.5"/>',
  star: '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>',
  frame: '<path d="M8 3.5v17M16 3.5v17M3.5 8h17M3.5 16h17"/>',
  contrast: '<circle cx="12" cy="12" r="8.5"/><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"/>',
  ruler: '<rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M6.5 8v3M10 8v4.5M13.5 8v3M17 8v4.5"/>',
  doc: '<path d="M6 3.5h8l4 4v13H6z"/><path d="M14 3.5v4h4M9 12h6M9 15.5h6"/>',
  person: '<circle cx="12" cy="8.5" r="4"/><path d="M4.5 20.5c1.2-3.9 4-5.7 7.5-5.7s6.3 1.8 7.5 5.7"/>',
};
---

{numbered.map(({ b, first }) => {
  switch (b.type) {
    case 'text':
      return <div class="cb-text">{b.body.map((p) => <p class="t-body">{p[locale]}</p>)}</div>;

    case 'heading':
      return (
        <div class="cb-heading">
          <h3 class="t-label">{b.text[locale]}</h3>
          {b.sub && <p class="t-caption">{b.sub[locale]}</p>}
        </div>
      );

    case 'diamond':
      return (
        <figure class="cb-diamond" data-reveal>
          <div class="cb-diamond__ends t-label" aria-hidden="true"><span>{b.problem[locale]}</span><span>{b.solution[locale]}</span></div>
          <svg class="cb-diamond__svg" viewBox="0 0 1200 220" preserveAspectRatio="none" aria-hidden="true">
            <path pathLength="1" d="M1 110 L300 8 L600 110 L300 212 Z" />
            <path pathLength="1" d="M600 110 L900 8 L1199 110 L900 212 Z" />
            <path pathLength="1" d="M1 110 H1199" />
          </svg>
          <ol class="cb-diamond__phases" role="list">
            {b.phases.map((ph) => (
              <li><h3>{ph.title[locale]}</h3><p>{ph.body[locale]}</p></li>
            ))}
          </ol>
          {b.note && <figcaption class="t-caption">{b.note[locale]}</figcaption>}
        </figure>
      );

    case 'marquee':
      return (
        <figure class="cb-marquee" style={`--row-h:${b.height ?? 300}px;${b.background ? `--mq-bg:${b.background};` : ''}`} data-marquee>
          {b.rows.map((img, r) => (
            <div class="cb-marquee__row" data-mq-row data-speed={b.speed ?? 35} data-dir={r % 2 ? 'right' : 'left'} data-cursor="drag" tabindex="0" role="region" aria-label={img.alt[locale]}>
              <div class="cb-marquee__track">
                {[0, 1].map((copy) => (
                  <Image src={img.src} alt={copy ? '' : img.alt[locale]} aria-hidden={copy ? 'true' : undefined} height={(b.height ?? 300) * 2} widths={[Math.round(img.src.width * ((b.height ?? 300) / img.src.height)), Math.min(img.src.width, Math.round(img.src.width * ((b.height ?? 300) * 2 / img.src.height)))]} sizes={`${Math.round(img.src.width * ((b.height ?? 300) / img.src.height))}px`} loading="lazy" draggable="false" />
                ))}
              </div>
            </div>
          ))}
          {b.caption && <figcaption class="t-caption cb-marquee__cap">{b.caption[locale]}</figcaption>}
        </figure>
      );

    case 'stats':
      return (
        <ul class="cb-cards cb-cards--3" role="list">
          {b.items.map((s, i) => (
            <li class="cb-card cb-card--stat paper-card lift" style={`--tilt:${tilt(i + 2)}deg`} data-reveal>
              <span class="cb-card__no t-heading-xl">{s.value[locale]}</span>
              <span class="cb-card__body">{s.label[locale]}</span>
            </li>
          ))}
        </ul>
      );

    case 'question':
      return (
        <div class="cb-question crop" data-reveal>
          <p class="t-label cb-question__label">{(b.label ?? ui.case.question)[locale]}</p>
          <p class="t-heading-s cb-question__text">{b.text[locale]}</p>
        </div>
      );

    case 'list':
      return (
        <div class="cb-list">
          {b.intro && <p class="t-body">{b.intro[locale]}</p>}
          <ol class="cb-list__items" role="list">
            {b.items.map((it, i) => (
              <li><span class="cb-list__no t-label" aria-hidden="true">{two(i)}</span><span class="t-body">{it[locale]}</span></li>
            ))}
          </ol>
        </div>
      );

    case 'groups':
      return (
        <div class="cb-decisions">
          {b.intro && <p class="t-body">{b.intro[locale]}</p>}
          <ul class="cb-cards cb-cards--4" role="list">
            {b.items.map((g, i) => (
              <li class="cb-card cb-card--group paper-card lift" style={`--tilt:${tilt(i)}deg`} data-reveal>
                <h3 class="cb-card__tag cb-group__title">{g.title[locale]}</h3>
                <ul class="cb-group__points" role="list">
                  {g.points.map((pt) => <li class="cb-card__body">{pt[locale]}</li>)}
                </ul>
              </li>
            ))}
          </ul>
        </div>
      );

    case 'swatches':
      return (
        <div class="cb-swatches">
          <p class="t-label cb-swatches__label">{b.label[locale]}</p>
          <ul class="cb-swatches__row" role="list">
            {b.colors.map((hex, i) => (
              <li class="cb-swatch paper-card lift" style={`--tilt:${tilt(i)}deg`}>
                <span class="cb-swatch__chip" style={`background:${hex}`} aria-hidden="true"></span>
                <span class="cb-swatch__hex">{hex}</span>
              </li>
            ))}
          </ul>
        </div>
      );

    case 'compare':
      return (
        <div class="cb-cards cb-cards--compare">
          {[b.before, b.after].map((side, i) => (
            <div class:list={['cb-card cb-card--compare paper-card lift', i === 1 && 'is-after']} style={`--tilt:${tilt(i + 1)}deg`} data-reveal>
              <p class="t-label cb-compare__label"><span aria-hidden="true">{i === 1 ? '✓' : '✕'}</span> {side.label[locale]}</p>
              <dl class="cb-compare__rows">
                {side.rows.map((r) => (
                  <div><dt>{r.key[locale]}</dt><dd>{r.value[locale]}</dd></div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      );

    case 'figure':
      return <CaseFigure image={b.image} caption={b.caption} locale={locale} n={first} />;

    case 'gallery':
      return (
        <figure class="cb-gallery">
          <ul class="cb-gallery__row" role="list">
            {b.images.map((img, i) => (
              <li style={`flex:${(img.src.width / img.src.height).toFixed(3)} 1 0`}><CaseFigure image={img} locale={locale} n={first + i} bare sizes="(max-width: 40rem) 100vw, 20rem" /></li>
            ))}
          </ul>
          <figcaption class="t-caption cb-gallery__cap">
            <span class="cb-gallery__no">{ui.case.fig[locale]} {String(first).padStart(2, '0')}–{String(first + b.images.length - 1).padStart(2, '0')}</span>
            {b.caption && <span> · {b.caption[locale]}</span>}
          </figcaption>
        </figure>
      );

    case 'steps':
      return (
        <ol class="cb-cards cb-cards--4" role="list">
          {b.items.map((s, i) => (
            <li class="cb-card paper-card lift" style={`--tilt:${tilt(i)}deg`} data-reveal>
              <span class="cb-card__no t-heading-xl" aria-hidden="true">{two(i)}</span>
              <h3 class="cb-card__title cb-card__title--sans"><span class="visually-hidden">{two(i)}. </span>{s.title[locale]}</h3>
              <p class="cb-card__body">{s.body[locale]}</p>
            </li>
          ))}
        </ol>
      );

    case 'decisions':
      return (
        <div class="cb-decisions">
          {b.intro && <p class="t-body">{b.intro[locale]}</p>}
          <ul class="cb-cards cb-cards--3" role="list">
            {b.items.map((d, i) => (
              <li class:list={['cb-card paper-card lift', d.state && `cb-card--${d.state}`]} style={`--tilt:${tilt(i + 1)}deg`} data-reveal>
                <svg class="cb-card__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[d.icon]} />
                <h3 class="cb-card__title t-heading-m">{d.title[locale]}</h3>
                <p class="cb-card__body">
                  {d.body[locale]}{d.note && <span class="cb-card__note"> {d.note[locale]}</span>}
                </p>
                {d.tag && <p class="cb-card__tag">{d.tag[locale]}</p>}
              </li>
            ))}
          </ul>
        </div>
      );

    case 'slots':
      return (
        <figure class="cb-slots">
          <ul class="cb-slots__row" role="list">
            {b.items.map((sl, i) => {
              const [w, h] = sl.ratio.split('/').map(Number);
              return (
                <li style={`flex:${(w / h).toFixed(3)} 1 0`}>
                  <div class="cb-slot crop" style={`aspect-ratio:${sl.ratio}`} role="img" aria-label={sl.alt[locale]}>
                    <span class="cb-slot__id" aria-hidden="true">{sl.id} · {ui.case.fig[locale]} {String(first + i).padStart(2, '0')}</span>
                    <span class="cb-slot__alt" aria-hidden="true">{sl.alt[locale]}</span>
                    <span class="cb-slot__soon" aria-hidden="true">{ui.case.slot[locale]}</span>
                  </div>
                </li>
              );
            })}
          </ul>
          {b.caption && (
            <figcaption class="t-caption cb-gallery__cap">
              <span class="cb-gallery__no">{ui.case.fig[locale]} {String(first).padStart(2, '0')}{b.items.length > 1 && `–${String(first + b.items.length - 1).padStart(2, '0')}`}</span>
              <span> · {b.caption[locale]}</span>
            </figcaption>
          )}
        </figure>
      );

    case 'table':
      return (
        <div class="cb-table" tabindex="0" role="region" aria-label={b.head.map((h) => h[locale]).join(' · ')}>
          <table>
            {b.caption && <caption class="t-caption">{b.caption[locale]}</caption>}
            <thead><tr>{b.head.map((h) => <th scope="col" class="t-label">{h[locale]}</th>)}</tr></thead>
            <tbody>
              {b.rows.map((r) => (
                <tr class:list={[r.muted && 'is-muted']}>
                  {r.cells.map((c, ci) => ci === 0 ? <th scope="row">{c[locale]}</th> : <td>{c[locale]}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      );

    case 'timeline':
      return (
        <div class="cb-timeline" tabindex="0" role="region" aria-label={b.items[0].date[locale] + ' – ' + b.items[b.items.length - 1].date[locale]} data-cursor="drag">
          <ol class="cb-timeline__line" role="list">
            {b.items.map((it, i) => (
              <>
                {b.marker && b.marker.before === i && (
                  <li class="cb-timeline__marker"><span class="t-label">{b.marker.label[locale]}</span></li>
                )}
                <li class="cb-timeline__item">
                  <span class="cb-timeline__date t-label">{it.date[locale]}</span>
                  <span class="cb-timeline__topic">{it.topic[locale]}</span>
                </li>
              </>
            ))}
          </ol>
        </div>
      );

    case 'defs':
      return (
        <div class="cb-defs">
          {b.title && <h3 class="cb-defs__title t-heading-m">{b.title[locale]}</h3>}
          {b.items.length > 0 && (
            <dl class="cb-defs__rows">
              {b.items.map((d) => (
                <div><dt class="t-label">{d.term[locale]}</dt><dd>{d.body[locale]}</dd></div>
              ))}
            </dl>
          )}
        </div>
      );

    case 'cards': {
      const Tag = b.numbered ? 'ol' : 'ul';
      return (
        <div class="cb-cards-wrap">
          <Tag class="cb-cards cb-cards--3" role="list">
            {b.items.map((c, i) => (
              <li class="cb-card cb-card--plain paper-card lift" style={`--tilt:${tilt(i)}deg`} data-reveal>
                {b.numbered && <span class="cb-card__no t-heading-xl" aria-hidden="true">{two(i)}</span>}
                <h3 class="cb-card__title cb-card__title--sans">{b.numbered && <span class="visually-hidden">{two(i)}. </span>}{c.title[locale]}</h3>
                {c.body && <p class="cb-card__body">{c.body[locale]}</p>}
                {c.tag && <p class="cb-card__pill">{c.tag[locale]}</p>}
              </li>
            ))}
          </Tag>
          {b.loop && <p class="cb-cards__loop t-label"><span aria-hidden="true">↻</span> {b.loop[locale]}</p>}
        </div>
      );
    }

    case 'pull':
      return <p class="cb-pull t-heading-l" data-reveal>{b.text[locale]}</p>;

    case 'map': {
      // Jobs around a centre, on an ellipse (percent coordinates).
      const n = b.items.length;
      const pos = b.items.map((_, i) => {
        const a = (i / n) * Math.PI * 2 - Math.PI / 2;
        return { x: 50 + Math.cos(a) * 38, y: 50 + Math.sin(a) * 38 };
      });
      return (
        <figure class="cb-map" aria-label={b.label[locale]}>
          <svg class="cb-map__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {pos.map((p) => <line x1="50" y1="50" x2={p.x} y2={p.y} />)}
          </svg>
          <p class="cb-map__center t-label">{b.center[locale]}</p>
          <ul class="cb-map__items" role="list">
            {b.items.map((it, i) => (
              <li style={`--x:${pos[i].x.toFixed(2)}%;--y:${pos[i].y.toFixed(2)}%`}>{it[locale]}</li>
            ))}
          </ul>
        </figure>
      );
    }
  }
})}

<style is:global>
  /* Global (prefixed cb-/cfig) so sealed cases, injected after unlock, are styled. */
  .cb-heading { display: grid; gap: var(--space-2); margin-bottom: calc(-1 * var(--space-6)); }
  .cb-heading h3 { color: var(--color-graphite-soft); }

  /* Double Diamond: thin outline drawn in when it scrolls in. */
  .cb-diamond { display: grid; gap: var(--space-4); margin: 0; }
  .cb-diamond__ends { display: flex; justify-content: space-between; color: var(--color-graphite-soft); }
  .cb-diamond__svg { width: 100%; height: clamp(7rem, 14vw, 12rem); overflow: visible; }
  .cb-diamond__svg path { fill: none; stroke: var(--color-ink); stroke-width: 1.2; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .js-reveal .cb-diamond__svg path { stroke-dashoffset: 1; transition: stroke-dashoffset 1.6s var(--ease-settle); }
  .js-reveal .cb-diamond.is-revealed .cb-diamond__svg path { stroke-dashoffset: 0; }
  .js-reveal .cb-diamond.is-revealed .cb-diamond__svg path:nth-child(2) { transition-delay: 0.35s; }
  .js-reveal .cb-diamond.is-revealed .cb-diamond__svg path:nth-child(3) { transition-delay: 0.7s; }
  .cb-diamond__phases { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); }
  .cb-diamond__phases li { display: grid; gap: var(--space-1); align-content: start; padding-top: var(--space-3); border-top: var(--rule-hair); }
  .cb-diamond__phases h3 { font-family: var(--font-system); font-size: var(--type-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-ink); }
  .cb-diamond__phases p { font-size: var(--type-body-s); color: var(--color-graphite); text-wrap: pretty; }

  /* Marquee: each row is two copies of an image strip that drifts one copy's
     width, forever (script below); alternate rows run the other way. The row
     is a real scroller: drag, swipe, wheel or arrow keys move it by hand, and
     the drift picks up again a moment later. */
  .cb-marquee { display: grid; gap: var(--space-3); margin: 0; }
  .cb-marquee__row { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; background: var(--mq-bg, transparent); cursor: grab; }
  .cb-marquee__row::-webkit-scrollbar { display: none; }
  .cb-marquee__row.is-dragging { cursor: grabbing; }
  .cb-marquee__row:focus-visible { outline: 2px solid var(--color-focus); outline-offset: -2px; }
  .cb-marquee[style*='--mq-bg'] { gap: 0; }
  .cb-marquee__track { display: flex; gap: var(--space-8); width: max-content; }
  .cb-marquee__track img { height: var(--row-h); width: auto; flex: none; user-select: none; pointer-events: none; }
  .cb-marquee__cap { margin-top: var(--space-3); }
  @media (prefers-reduced-motion: reduce) {
    .cb-marquee__track img[aria-hidden='true'] { display: none; }
  }
  @media (max-width: 40rem) {
    .cb-marquee__track img { height: calc(var(--row-h) * 0.6); }
    .cb-diamond__phases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .cb-text { display: grid; gap: var(--space-4); max-width: var(--layout-text); }
  .cb-text p { text-wrap: pretty; }

  .cb-question {
    display: grid;
    gap: var(--space-3);
    max-width: 48rem;
    padding: var(--space-8);
    background: var(--color-paper-shade);
  }
  .cb-question__label { color: var(--color-accent); }
  .cb-question__text { color: var(--color-ink); text-wrap: pretty; }

  /* Cards: paper notes with a double frame, each a hair off straight. */
  .cb-cards { display: grid; gap: var(--space-6); padding: var(--space-2); }
  /* As many columns as fit: 3 stats, 3–4 decisions, 4–5 steps on desktop. */
  .cb-cards--4 { grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .cb-cards--3 { grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .cb-cards--compare { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* The surface (paper, double frame, tilt) is .paper-card in components.css. */
  .cb-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 22rem;
    padding: var(--space-8) var(--space-6);
  }
  .cb-card--stat { min-height: 0; gap: var(--space-2); }
  .cb-card__no { color: var(--color-ink); margin-bottom: var(--space-2); }
  .cb-card__icon { width: 2rem; height: 2rem; fill: none; stroke: var(--color-ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; margin-bottom: var(--space-2); }
  .cb-card__title { color: var(--color-ink); text-wrap: balance; }
  .cb-card__title--sans { font-family: var(--font-body); font-size: var(--type-heading-s); font-weight: 500; letter-spacing: -0.01em; line-height: 1.25; }
  .cb-card__body { font-size: var(--type-body-s); line-height: var(--leading-body); color: var(--color-graphite); text-wrap: pretty; }
  .cb-card__note { color: var(--color-graphite-soft); }
  .cb-card__tag { margin-top: var(--space-1); font-size: var(--type-meta); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-graphite-soft); }

  .cb-decisions { display: grid; gap: var(--space-8); }
  /* Options weighed: rejected ones are faded, dashed prints; the chosen one is
     ink-framed with a blue tab, same language as before/after. */
  .cb-card--rejected { background: var(--color-paper-shade); border-style: dashed; box-shadow: 0 0 0 7px var(--color-paper-shade), 0 0 0 8px var(--color-rule); }
  .cb-card--rejected.lift { --lift-shadow: 0 0 0 7px var(--color-paper-shade), 0 0 0 8px var(--color-rule), 3px 3px 0 8px var(--color-shadow); }
  .cb-card--rejected .cb-card__title, .cb-card--rejected .cb-card__body { color: var(--color-graphite-soft); }
  .cb-card--rejected .cb-card__icon { stroke: var(--color-graphite-soft); }
  .cb-card--rejected .cb-card__tag { margin-top: auto; text-decoration: line-through; }
  .cb-card--chosen { border-color: var(--color-ink); box-shadow: 0 0 0 7px var(--color-paper), 0 0 0 8px var(--color-ink); }
  .cb-card--chosen.lift { --lift-shadow: 0 0 0 7px var(--color-paper), 0 0 0 8px var(--color-ink), 3px 3px 0 8px var(--color-shadow); }
  .cb-card--rejected.lift:hover, .cb-card--chosen.lift:hover { box-shadow: var(--lift-shadow); }
  .cb-card--chosen .cb-card__icon { stroke: var(--color-accent); }
  .cb-card--chosen .cb-card__tag {
    align-self: flex-start;
    margin-top: auto;
    padding: var(--space-1) var(--space-2);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .cb-gallery { display: grid; gap: var(--space-3); margin: 0; }
  /* Each image gets width in proportion to its shape, so a row shares one height. */
  .cb-gallery__row { display: flex; align-items: flex-start; gap: var(--space-4); }
  .cb-gallery__row li { min-width: 0; }

  .cb-list { display: grid; gap: var(--space-4); max-width: 48rem; }
  .cb-list__items { display: grid; }
  .cb-list__items li { display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--space-2); padding-block: var(--space-3); border-top: var(--rule-hair); }
  .cb-list__items li:last-child { border-bottom: var(--rule-hair); }
  .cb-list__no { color: var(--color-accent); padding-top: 0.2em; }

  .cb-card--group { min-height: 0; gap: var(--space-4); }
  .cb-group__title { margin-top: 0; color: var(--color-ink); }
  .cb-group__points { display: grid; gap: var(--space-2); }
  .cb-group__points li { position: relative; padding-left: 1em; }
  .cb-group__points li::before { content: '·'; position: absolute; left: 0.2em; color: var(--color-accent); font-weight: 700; }

  .cb-swatches { display: grid; gap: var(--space-4); }
  .cb-swatches__label { color: var(--color-graphite-soft); }
  .cb-swatches__row { display: flex; flex-wrap: wrap; gap: var(--space-6); padding: var(--space-2); }
  .cb-swatch { display: grid; gap: var(--space-2); width: 8.5rem; padding: var(--space-2) var(--space-2) var(--space-3); }
  .cb-swatch__chip { display: block; height: 5.5rem; }
  .cb-swatch__hex { font-family: var(--font-system); font-size: var(--type-meta); color: var(--color-ink); }

  .cb-card--compare { min-height: 0; gap: var(--space-4); }
  /* Before: a faded, dashed print. After: crisp, ink-framed, with a blue tab. */
  .cb-card--compare:not(.is-after) { background: var(--color-paper-shade); border-style: dashed; box-shadow: 0 0 0 7px var(--color-paper-shade), 0 0 0 8px var(--color-rule); }
  .cb-card--compare.is-after { border-color: var(--color-ink); box-shadow: 0 0 0 7px var(--color-paper), 0 0 0 8px var(--color-ink); }
  .cb-card--compare:not(.is-after).lift { --lift-shadow: 0 0 0 7px var(--color-paper-shade), 0 0 0 8px var(--color-rule), 3px 3px 0 8px var(--color-shadow); }
  .cb-card--compare.is-after.lift { --lift-shadow: 0 0 0 7px var(--color-paper), 0 0 0 8px var(--color-ink), 3px 3px 0 8px var(--color-shadow); }
  .cb-card--compare.lift:hover { box-shadow: var(--lift-shadow); }
  .cb-compare__label {
    justify-self: start;
    align-self: start;
    padding: var(--space-1) var(--space-2);
    border: 1px solid currentColor;
